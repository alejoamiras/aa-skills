#!/usr/bin/env bash
# send-to-mac — push a build (browser-extension dist, etc.) from this box to the
# Mac over Tailscale via Taildrop, so you skip the smb://→Finder→download dance.
#
#   send-to-mac <path>
#
# Directories are zipped first (Taildrop sends discrete files); plain files go
# as-is. Lands in the Mac's Taildrop inbox (Tailscale menu / ~/Downloads). The
# macOS peer is auto-detected (first macOS host in the tailnet); override with
# $SEND_TO_MAC_HOST.
#
# NB: Taildrop deliberately, not rsync/SSH — no inbound shell access to the Mac.
set -euo pipefail

die() { echo "send-to-mac: $*" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: send-to-mac <path>"
SRC="$1"
[ -e "$SRC" ] || die "path does not exist: $SRC"
SRC="$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")"   # absolutize
NAME="$(basename "$SRC")"

# Locate the Mac: explicit override, else first macOS peer in the tailnet.
HOST="${SEND_TO_MAC_HOST:-}"
if [ -z "$HOST" ]; then
  HOST="$(tailscale status --json 2>/dev/null \
    | jq -r 'first(.Peer[]? | select(.OS=="macOS") | .DNSName) // empty' \
    | sed 's/\.$//')"
fi
[ -n "$HOST" ] || die "no macOS peer found in tailnet (set \$SEND_TO_MAC_HOST)"

# Zip directories so they arrive as one item; send files as-is.
PAYLOAD="$SRC"; CLEANUP=""
if [ -d "$SRC" ]; then
  TMP="$(mktemp -d)"; CLEANUP="$TMP"
  PAYLOAD="$TMP/${NAME}.zip"
  ( cd "$(dirname "$SRC")" && zip -qr "$PAYLOAD" "$NAME" )
  echo "send-to-mac: zipped '$NAME/' → ${NAME}.zip"
fi

if tailscale file cp "$PAYLOAD" "${HOST}:"; then
  echo "send-to-mac: sent to ${HOST%%.*} via Taildrop → accept on the Mac (Tailscale menu / ~/Downloads)."
  rc=0
else
  echo "send-to-mac: Taildrop send failed" >&2
  rc=1
fi
[ -n "$CLEANUP" ] && rm -rf "$CLEANUP"
exit $rc
