#!/usr/bin/env bash
# clu — `claude-usage run` for the fingers, with all permission checks off.
#
#   clu                    claude on the best account right now
#   clu proton             claude on the one roster account whose name has "proton"
#   clu proton -p "…"      every argument after the account goes to claude
#   clu -p "…"             a leading option means: best account, all args to claude
#
# clu adds --dangerously-skip-permissions unless the arguments set a permission
# mode; `claude-usage run`, which leads, workers and consults use, never does.
# The sibling claude-usage wins over PATH, so a checkout's clu never runs some
# other install's claude-usage.
unset CDPATH
here=$(cd "$(dirname "$0")" && pwd)
acct=()
if [[ ${1:-} == -- ]]; then acct=(--); shift
elif [[ -n ${1:-} && $1 != -* ]]; then acct=("$1"); shift; fi
bypass=(--dangerously-skip-permissions)
for a in "$@"; do
  case $a in --dangerously-skip-permissions | --permission-mode | --permission-mode=*) bypass=() ;; esac
done
cu=claude-usage
[[ -x ${here}/claude-usage ]] && cu=${here}/claude-usage
exec "${cu}" run "${acct[@]}" "${bypass[@]}" "$@"
