#!/usr/bin/env bash
# agent-worktree — task-named git worktrees + the ~/.agents/workspaces.md manifest.
#
# One canonical clone per repo; parallel tasks live in worktrees under
# .claude/worktrees/<slug> (Claude Code's native layout). This helper creates
# them with env carry-over + deps, and maintains the cross-agent manifest of
# who is WORKING on what, where (sibling of ~/.agents/ports.md).
#
#   agent-worktree new <slug> [--plan <path>] [--start|--no-start]
#   agent-worktree list
#   agent-worktree resume <slug> [--pick]
#   agent-worktree status <slug> <one-line status...>
#   agent-worktree done <slug> [--force|--forget]   (--forget: drop the row only, touch no disk)
#   agent-worktree done <slug> --merged [--trunk <branch>]   (post-merge teardown, squash-aware)
#   agent-worktree register <slug> [--plan <path>] [--status <text>]   (run from inside the worktree)
#
# done --merged is the close-out after a PR (or a whole stack) has landed: it
# proves the worktree's HEAD is fully contained in origin's trunk, then removes
# the worktree, every local branch of its stack, their merged remote
# counterparts, and the row. It refuses instead of forcing: unmerged or
# uncommitted work, or a worktree holding submodules, stays. Needs git >= 2.38.
#
# <slug> may be qualified as <repo>/<slug> when the same slug exists in two
# repos, or given as the absolute worktree path when even that is ambiguous;
# unqualified lookups die on ambiguity instead of guessing. Row identity is
# the worktree PATH (globally unique); slug/repo are lookup sugar.
# Manifest rows self-heal: entries whose worktree path is gone are pruned on
# every list/write. AGENTS_DIR overrides ~/.agents (used by tests).
# shellcheck disable=SC2016  # single-quoted awk programs use $N field refs by design
set -euo pipefail

AGENTS_DIR="${AGENTS_DIR:-$HOME/.agents}"
# `done` changes directory and may delete the one a relative path runs through.
case "$AGENTS_DIR" in /*) ;; *) mkdir -p "$AGENTS_DIR" && AGENTS_DIR="$(cd "$AGENTS_DIR" && pwd -P)" ;; esac
MANIFEST="$AGENTS_DIR/workspaces.md"
LOCK_DIR="$AGENTS_DIR/.workspaces.lock"
LOCKED=0

die() { echo "agent-worktree: $*" >&2; exit 1; }

usage() {
  sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- manifest primitives -----------------------------------------------------

# mkdir-based lock with dead-owner reclaim: the holder records "pid host" in
# $LOCK_DIR/owner; waiters reclaim only locks whose local owner is gone.
lock() {
  mkdir -p "$AGENTS_DIR"
  local n=0 opid ohost
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    if [ -f "$LOCK_DIR/owner" ]; then
      read -r opid ohost < "$LOCK_DIR/owner" 2>/dev/null || opid=""
      if [ "$ohost" = "$(hostname)" ] && [ -n "$opid" ] && ! kill -0 "$opid" 2>/dev/null; then
        rm -f "$LOCK_DIR/owner" && rmdir "$LOCK_DIR" 2>/dev/null || true
        continue
      fi
    fi
    n=$((n + 1))
    [ "$n" -gt 100 ] && die "manifest lock timeout — holder $(cat "$LOCK_DIR/owner" 2>/dev/null || echo unknown); if truly stale, remove $LOCK_DIR"
    sleep 0.1
  done
  echo "$$ $(hostname)" > "$LOCK_DIR/owner"
  LOCKED=1
  # A signal must end the run: a handler that only unlocked would let the
  # interrupted command sequence carry on without the lock.
  trap 'unlock' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

unlock() {
  if [ "$LOCKED" = 1 ]; then
    rm -f "$LOCK_DIR/owner"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    LOCKED=0
  fi
  return 0
}

ensure_manifest() {
  mkdir -p "$AGENTS_DIR"
  if [ ! -f "$MANIFEST" ]; then
    cat > "$MANIFEST" <<'EOF'
# Agent workspaces — who is working on what, where
<!-- Managed by `agent-worktree`. One row per active worktree. Self-healing: -->
<!-- rows whose worktree path no longer exists are pruned on list/write. -->
<!-- Same slug in two repos? Qualify commands as <repo>/<slug>. -->

| slug | repo | branch | plan | status | updated | path |
|---|---|---|---|---|---|---|
EOF
  fi
}

sanitize() { printf '%s' "$*" | tr '|\n\r' '/  ' | cut -c1-120; }

validate_slug() {
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9._-]{0,63}$' \
    || die "invalid slug '$1' (want: lowercase kebab-case, e.g. escrow-refund)"
}

# manifest rows are a pipe table; paths that contain pipes/newlines can't be
# represented safely, so refuse them outright rather than corrupting rows.
validate_table_safe() {
  case "$1" in
    *'|'* | *$'\n'* | *$'\r'*) die "path contains characters the manifest can't represent: $1" ;;
  esac
}

is_data_row() {
  case "$1" in
    '| slug |'*) return 1 ;;
    '|---'*) return 1 ;;
    '| '*) return 0 ;;
    *) return 1 ;;
  esac
}

field_of() { # field_of <row> <n>  (1=slug 2=repo 3=branch 4=plan 5=status 6=updated 7=path)
  printf '%s' "$1" | awk -F'|' -v n="$(( $2 + 1 ))" '{ gsub(/^ +| +$/, "", $n); print $n }'
}

# resolve_row <slug | repo/slug | /abs/worktree/path> — dies on 0 or >1
# matches; on success sets RESOLVED_ROW / RESOLVED_SLUG / RESOLVED_REPO /
# RESOLVED_PATH (globals — callers must NOT invoke this in a $(...) subshell
# or the results won't propagate). Row identity is the path.
resolve_row() {
  local arg="$1" want_repo="" want_slug="" want_path="" want_rpath="" matches row f7 f7r
  case "$arg" in
    /*) want_path="$arg"; want_rpath="$(realpath "$arg" 2>/dev/null || printf '%s' "$arg")" ;;
    */*) want_repo="${arg%%/*}"; want_slug="${arg#*/}"; validate_slug "$want_slug" ;;
    *) want_slug="$arg"; validate_slug "$want_slug" ;;
  esac
  matches=""
  [ -f "$MANIFEST" ] || die "no manifest yet ($MANIFEST)"
  while IFS= read -r row; do
    is_data_row "$row" || continue
    if [ -n "$want_path" ]; then
      f7="$(field_of "$row" 7)"
      f7r="$(realpath "$f7" 2>/dev/null || printf '%s' "$f7")"   # normalize BOTH sides
      { [ "$f7" = "$want_path" ] || [ "$f7" = "$want_rpath" ] \
        || [ "$f7r" = "$want_path" ] || [ "$f7r" = "$want_rpath" ]; } || continue
    else
      [ "$(field_of "$row" 1)" = "$want_slug" ] || continue
      [ -n "$want_repo" ] && [ "$(field_of "$row" 2)" != "$want_repo" ] && continue
    fi
    matches="${matches}${row}"$'\n'
  done < "$MANIFEST"
  matches="${matches%$'\n'}"
  [ -n "$matches" ] || die "unknown workspace '$arg' (agent-worktree list)"
  if [ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]; then
    {
      echo "agent-worktree: ambiguous '$arg' — qualify as <repo>/<slug>, or pass the exact path:"
      printf '%s\n' "$matches" | while IFS= read -r row; do
        echo "  $(field_of "$row" 2)/$(field_of "$row" 1)  →  $(field_of "$row" 7)"
      done
    } >&2
    exit 1
  fi
  RESOLVED_ROW="$matches"
  RESOLVED_SLUG="$(field_of "$matches" 1)"
  RESOLVED_REPO="$(field_of "$matches" 2)"
  RESOLVED_PATH="$(field_of "$matches" 7)"
}

# rewrite_manifest <awk-body> [extra awk -v args...]
rewrite_manifest() {
  local body="$1"; shift
  local prog tmp
  prog='/^\| slug \|/ || /^\|---/ || !/^\| / { print; next } '"$body"
  tmp="$(mktemp "$AGENTS_DIR/.workspaces.XXXXXX")"
  awk -F'|' -v OFS='|' "$@" "$prog" "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

prune_dead_rows() { # caller holds the lock
  local tmp pruned=0 line p
  tmp="$(mktemp "$AGENTS_DIR/.workspaces.XXXXXX")"
  while IFS= read -r line; do
    if is_data_row "$line"; then
      p="$(field_of "$line" 7)"
      if [ ! -d "$p" ]; then pruned=$((pruned + 1)); continue; fi
    fi
    printf '%s\n' "$line"
  done < "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
  [ "$pruned" -gt 0 ] && echo "pruned $pruned stale row(s) (worktree gone)" >&2
  return 0
}

now() { date +'%FT%H:%M'; }

# append_row — caller holds the lock and has already dropped any old row
append_row() { # <slug> <repo> <branch> <plan> <status> <path>
  printf '| %s | %s | %s | %s | %s | %s | %s |\n' \
    "$1" "$(sanitize "$2")" "$(sanitize "$3")" "$(sanitize "$4")" \
    "$(sanitize "$5")" "$(now)" "$6" >> "$MANIFEST"
}

upsert_row() { # <slug> <repo> <branch> <plan> <status> <path> — keyed by PATH (unique identity)
  lock; ensure_manifest; prune_dead_rows
  rewrite_manifest '$8 == " " p " " { next } { print }' -v p="$6"
  append_row "$@"
  unlock
}

# --- git helpers ---------------------------------------------------------------

repo_root_or_die() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }

in_linked_worktree() {
  local gd cd_
  gd="$(git rev-parse --path-format=absolute --git-dir)"
  cd_="$(git rev-parse --path-format=absolute --git-common-dir)"
  [ "$gd" != "$cd_" ]
}

# verify_layout <path> <slug> — dies unless <path> is a real worktree in the
# native layout of the clone it sits in; sets WT_ROOT. Manifest fields are
# never trusted for destructive ops: everything is re-derived from git.
verify_layout() {
  local path="$1" suffix="/.claude/worktrees/$2" wt_common
  [ -L "$path" ] && die "refusing: $path is a symlink"
  case "$path" in
    *"$suffix") ;;
    *) die "refusing: $path doesn't match the native layout for '$2' — clean up manually" ;;
  esac
  WT_ROOT="${path%"$suffix"}"
  wt_common="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "refusing: $path is not a git worktree"
  [ "$wt_common" = "$WT_ROOT/.git" ] || die "refusing: $path does not belong to $WT_ROOT"
}

# landed <root> <commit> <trunk> [<verified-head>] — true when <commit> is in
# trunk's history, in the history of a head already proven landed (a lower
# layer of the same stack: its commits ARE that head's), or — after a squash
# merge, where ancestry is gone — when merging it into trunk changes nothing.
# Fails closed: a conflict, an unrelated history or git < 2.38 all read as not
# landed, so trunk rewriting the same lines later errs towards keeping.
landed() {
  local root="$1" c="$2" trunk="$3" head="${4:-}" tree
  git -C "$root" merge-base --is-ancestor "$c" "$trunk" 2>/dev/null && return 0
  if [ -n "$head" ] && git -C "$root" merge-base --is-ancestor "$c" "$head" 2>/dev/null; then return 0; fi
  # A custom merge driver (merge=ours and friends) can settle a real conflict
  # in trunk's favour, which would read as "changes nothing".
  [ -z "$(git -C "$root" config --get-regexp '^merge\..*\.driver$' 2>/dev/null)" ] || return 1
  tree="$(git -C "$root" merge-tree --write-tree "$trunk" "$c" 2>/dev/null | head -n 1)" || return 1
  [ -n "$tree" ] && [ "$tree" = "$(git -C "$root" rev-parse "$trunk^{tree}")" ]
}

# --- subcommands ---------------------------------------------------------------

cmd_new() {
  local slug="" plan="-" start="auto"
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) plan="$2"; shift 2 ;;
      --start) start="yes"; shift ;;
      --no-start) start="no"; shift ;;
      -*) die "unknown flag for new: $1" ;;
      *) [ -n "$slug" ] && die "unexpected arg: $1"; slug="$1"; shift ;;
    esac
  done
  [ -n "$slug" ] || usage 1
  validate_slug "$slug"

  local root; root="$(repo_root_or_die)"
  validate_table_safe "$root"
  in_linked_worktree && die "you're inside a worktree — run 'new' from the canonical clone"
  git -C "$root" rev-parse --verify --quiet HEAD >/dev/null \
    || die "repository has no commits yet — commit something first"

  local wt_dir="$root/.claude/worktrees/$slug" branch="worktree-$slug"
  [ -e "$wt_dir" ] && die "already exists: $wt_dir (agent-worktree resume $slug?)"
  git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && die "branch $branch already exists"

  # keep worktrees out of git status without touching the tracked .gitignore
  local exclude; exclude="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  grep -qxF '.claude/worktrees/' "$exclude" 2>/dev/null || echo '.claude/worktrees/' >> "$exclude"

  # branch from clean origin default when resolvable (native `fresh` behavior)
  local base="HEAD"
  if git -C "$root" remote get-url origin >/dev/null 2>&1; then
    git -C "$root" fetch origin --quiet 2>/dev/null || echo "warn: fetch failed; branching from local HEAD" >&2
    git -C "$root" remote set-head origin --auto >/dev/null 2>&1 || true
    local def; def="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [ -n "$def" ] && git -C "$root" rev-parse --verify --quiet "$def" >/dev/null && base="$def"
  fi

  git -C "$root" worktree add -b "$branch" "$wt_dir" "$base"

  # .worktreeinclude carry-over (native only processes it for claude-created
  # worktrees). Hardened: regular files only, no symlinks anywhere in the
  # source path, never overwrite anything tracked or existing in the target.
  if [ -f "$root/.worktreeinclude" ]; then
    git -C "$root" ls-files --others --ignored --exclude-from="$root/.worktreeinclude" -z 2>/dev/null \
      | while IFS= read -r -d '' f; do
          case "$f" in .claude/worktrees/*) continue ;; esac
          git -C "$root" check-ignore -q "$f" || continue        # native rule: must ALSO be gitignored
          local src="$root/$f" dst="$wt_dir/$f" rsrc reldir walk part bad
          if [ ! -f "$src" ] || [ -L "$src" ]; then echo "skip (not a regular file): $f" >&2; continue; fi
          rsrc="$(realpath "$src")"
          case "$rsrc" in "$root"/*) ;; *) echo "skip (escapes repo via symlink): $f" >&2; continue ;; esac
          if git -C "$wt_dir" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
            echo "skip (tracked in target): $f" >&2; continue
          fi
          if [ -e "$dst" ] || [ -L "$dst" ]; then echo "skip (already exists in target): $f" >&2; continue; fi
          # walk destination components WITHOUT following symlinks, BEFORE any
          # mkdir — a tracked symlink dir in the target must not be traversed
          reldir="$(dirname "$f")" walk="$wt_dir" bad=0
          if [ "$reldir" != "." ]; then
            local IFS='/'
            for part in $reldir; do
              walk="$walk/$part"
              if [ -L "$walk" ]; then bad=1; break; fi
              [ -e "$walk" ] || break   # rest doesn't exist; mkdir -p from here is safe
            done
            unset IFS
          fi
          if [ "$bad" = 1 ]; then echo "skip (symlinked dir component in target): $f" >&2; continue; fi
          mkdir -p "$(dirname "$dst")"
          cp "$src" "$dst" && echo "carried: $f"
        done
  fi

  if [ -f "$wt_dir/package.json" ] && command -v bun >/dev/null 2>&1; then
    (cd "$wt_dir" && bun install) || echo "warn: bun install failed — run it manually" >&2
  fi

  upsert_row "$slug" "$(basename "$root")" "$branch" "$plan" "new" "$wt_dir"

  echo ""
  echo "worktree ready: $wt_dir  (branch $branch, from $base)"
  echo "re-engage later: agent-worktree resume $slug"
  if [ "$start" = "yes" ] || { [ "$start" = "auto" ] && [ -t 0 ] && [ -t 1 ]; }; then
    cd "$wt_dir" && exec claude
  else
    echo "start: cd \"$wt_dir\" && claude"
  fi
}

cmd_register() {
  local slug="" plan="" status="registered"
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) plan="$2"; shift 2 ;;
      --status) status="$2"; shift 2 ;;
      -*) die "unknown flag for register: $1" ;;
      *) [ -n "$slug" ] && die "unexpected arg: $1"; slug="$1"; shift ;;
    esac
  done
  [ -n "$slug" ] || usage 1
  validate_slug "$slug"

  local top branch common repo
  top="$(repo_root_or_die)"
  validate_table_safe "$top"
  in_linked_worktree || die "register runs from INSIDE a worktree (EnterWorktree or agent-worktree new first)"
  case "$top" in
    */.claude/worktrees/"$slug") ;;
    *) die "cwd worktree is '$top' — it doesn't match slug '$slug' (native layout .claude/worktrees/<slug>)" ;;
  esac
  branch="$(git -C "$top" branch --show-current)"
  [ "$branch" = "worktree-$slug" ] \
    || die "cwd worktree is on branch '${branch:-detached}', expected 'worktree-$slug' — refusing to register a workspace this tool couldn't safely tear down"
  common="$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)"
  repo="$(basename "$(dirname "$common")")"
  [ -z "$plan" ] && plan="implementations-plan/$slug"

  grep -qxF '.claude/worktrees/' "$common/info/exclude" 2>/dev/null || echo '.claude/worktrees/' >> "$common/info/exclude"

  upsert_row "$slug" "$repo" "$branch" "$plan" "$status" "$top"
  echo "registered: $slug → $top"
}

cmd_status() {
  local arg="${1:-}"; shift || true
  [ -n "$arg" ] && [ $# -gt 0 ] || usage 1
  local text; text="$(sanitize "$*")"
  lock; ensure_manifest; prune_dead_rows
  resolve_row "$arg"
  rewrite_manifest '$8 == " " p " " { $6 = " " t " "; $7 = " " d " " } { print }' \
    -v p="$RESOLVED_PATH" -v t="$text" -v d="$(now)"
  unlock
  echo "status[$RESOLVED_REPO/$RESOLVED_SLUG] = $text"
}

cmd_list() {
  lock; ensure_manifest; prune_dead_rows; unlock
  cat "$MANIFEST"
  echo ""
  echo "re-engage: agent-worktree resume <slug>   ·   close out: agent-worktree done <slug>"
}

cmd_resume() {
  local arg="" pick=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pick) pick=1; shift ;;
      -*) die "unknown flag for resume: $1" ;;
      *) [ -n "$arg" ] && die "unexpected arg: $1"; arg="$1"; shift ;;
    esac
  done
  [ -n "$arg" ] || usage 1
  local path
  resolve_row "$arg"
  path="$(field_of "$RESOLVED_ROW" 7)"
  [ -d "$path" ] || die "worktree gone: $path (agent-worktree list prunes it)"
  local flag="--continue"; [ "$pick" = 1 ] && flag="--resume"
  if [ -t 0 ] && [ -t 1 ]; then
    cd "$path" && exec claude "$flag"
  else
    echo "cd \"$path\" && claude $flag"
  fi
}

cmd_done() {
  local arg="" force="" forget=0 merged=0 trunk_name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force="--force"; shift ;;
      --forget) forget=1; shift ;;
      --merged) merged=1; shift ;;
      --trunk) trunk_name="${2:-}"; [ -n "$trunk_name" ] || die "--trunk needs a branch name"; shift 2 ;;
      -*) die "unknown flag for done: $1" ;;
      *) [ -n "$arg" ] && die "unexpected arg: $1"; arg="$1"; shift ;;
    esac
  done
  [ -n "$arg" ] || usage 1
  [ "$merged" = 1 ] && [ -n "$force" ] && die "--merged never forces: drop --force"
  [ "$merged" = 1 ] && [ "$forget" = 1 ] && die "--merged and --forget are different jobs: pick one"
  [ "$merged" = 0 ] && [ -n "$trunk_name" ] && die "--trunk only applies to --merged"

  # The merge proof needs origin's current trunk, and a fetch is too slow to
  # run under the manifest lock (waiters give up after ~10s). A failed fetch
  # ends the run: a stale trunk could vouch for a merge origin no longer has.
  # Only trunk's own tracking ref is written (`--refmap=` switches off the
  # remote's configured refspecs): one mapping into refs/heads would let a
  # fetch move or prune local branches before any proof ran. The exact name
  # also keeps `--trunk HEAD` or `main~0` from slipping past the name
  # comparisons that keep trunk out of the delete list.
  local fetched_root="" trunk_ref=""
  if [ "$merged" = 1 ]; then
    resolve_row "$arg"
    if [ -d "$RESOLVED_PATH" ]; then
      verify_layout "$RESOLVED_PATH" "$RESOLVED_SLUG"
      fetched_root="$WT_ROOT"
      git -C "$fetched_root" remote get-url origin >/dev/null 2>&1 \
        || die "--merged needs an 'origin' remote to prove the merge against"
      if [ -n "$trunk_name" ]; then
        trunk_ref="refs/remotes/origin/$trunk_name"
      else
        git -C "$fetched_root" remote set-head origin --auto >/dev/null 2>&1 || true
        trunk_ref="$(git -C "$fetched_root" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
      fi
      { [ -n "$trunk_ref" ] && [ "$trunk_ref" != refs/remotes/origin/HEAD ] \
        && GIT_TERMINAL_PROMPT=0 git -C "$fetched_root" fetch --quiet --refmap= --no-prune --no-prune-tags origin \
             "+refs/heads/${trunk_ref#refs/remotes/origin/}:$trunk_ref" 2>/dev/null; } \
        || die "can't fetch the trunk branch from origin (offline, or pass --trunk <branch>) — the merge can't be proven against a stale trunk. Nothing was removed"
    fi
  fi

  # Whole lifecycle under one lock: re-resolve the row, verify everything
  # against git (never trust manifest fields for destructive ops), remove,
  # then drop the row. All ops are local + fast. Resolve BEFORE pruning: a
  # worktree already removed by hand must still resolve, so the "already
  # gone" branch below drops its row instead of dying "unknown workspace".
  lock; ensure_manifest
  local slug path root live_branch expected_branch
  local trunk="" trunk_short="" head="" mb b tip st doomed deleted=""
  resolve_row "$arg"
  prune_dead_rows
  slug="$RESOLVED_SLUG"
  path="$(field_of "$RESOLVED_ROW" 7)"
  expected_branch="worktree-$slug"

  # --forget: escape hatch for stale/poisoned rows — drop the row, touch no disk.
  if [ "$forget" = 1 ]; then
    rewrite_manifest '$8 == " " p " " { next } { print }' -v p="$path"
    unlock
    echo "row forgotten (disk untouched): $RESOLVED_REPO/$slug → $path"
    return 0
  fi

  if [ -d "$path" ]; then
    verify_layout "$path" "$slug"
    root="$WT_ROOT"
    live_branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
    cd "$root"   # the caller's cwd may be the worktree about to disappear

    if [ "$merged" = 1 ]; then
      # A stack leaves the worktree on its top branch, so the gate here is the
      # merge proof, not the branch name.
      [ "$root" = "$fetched_root" ] || die "refusing: the row for '$arg' changed while fetching — rerun"
      [ -n "$live_branch" ] || die "refusing: $path is on a detached HEAD — --merged needs a branch to prove merged"
      git -C "$root" show-ref --verify --quiet "$trunk_ref" || die "can't resolve the trunk on origin — pass --trunk <branch>"
      trunk_short="${trunk_ref#refs/remotes/origin/}"
      trunk="$(git -C "$root" rev-parse "$trunk_ref")"   # pinned: a concurrent fetch must not move the proof's target
      [ "$live_branch" != "$trunk_short" ] || die "refusing: $path is on the trunk branch itself"
      head="$(git -C "$path" rev-parse HEAD)"
      landed "$root" "$head" "$trunk" \
        || die "refusing: $live_branch carries changes that are not on origin/$trunk_short — not merged yet, trunk has since rewritten the same lines, or the repo configures a custom merge driver (which voids the squash proof). Nothing was removed"

      # The stack is every local branch between the fork point and HEAD: their
      # commits are HEAD's own history, whatever they are named. Branches at or
      # behind the fork point sit on trunk's side and belong to someone else.
      # Tips are pinned so a branch that moves before its delete is kept.
      mb="$(git -C "$root" merge-base "$head" "$trunk")"
      doomed="$live_branch $head"
      while read -r b tip; do
        [ "$b" = "$live_branch" ] && continue
        [ "$b" = "$trunk_short" ] && continue
        git -C "$root" merge-base --is-ancestor "$tip" "$mb" && continue
        doomed="$doomed"$'\n'"$b $tip"
      done < <(git -C "$root" for-each-ref --format='%(refname:short) %(objectname)' --merged "$head" refs/heads)
      if [ "$live_branch" != "$expected_branch" ] && [ "$expected_branch" != "$trunk_short" ] \
        && ! printf '%s\n' "$doomed" | cut -d' ' -f1 | grep -qxF "$expected_branch" \
        && tip="$(git -C "$root" rev-parse --verify --quiet "refs/heads/$expected_branch")"; then
        if landed "$root" "$tip" "$trunk" "$head"; then
          doomed="$doomed"$'\n'"$expected_branch $tip"
        else
          echo "branch kept (not on origin/$trunk_short): $expected_branch"
        fi
      fi

      # Checked last, right before the removal it guards. Flags are explicit
      # because status.showUntrackedFiles / diff.ignoreSubmodules can hide work
      # from git's own pre-removal check.
      st="$(git -C "$path" status --porcelain --untracked-files=all --ignore-submodules=none)" \
        || die "refusing: can't read the status of $path"
      [ -z "$st" ] || die "refusing: $path has uncommitted or untracked files — commit or delete them and rerun (--merged never discards work)"
      # Never forced. That also leaves a worktree holding submodules in place:
      # git refuses it, and removing it would delete those repositories along
      # with any commit, stash or reflog entry that exists nowhere else.
      git -C "$root" worktree remove "$path" \
        || die "git would not remove $path (reason above: changed since the check, locked, or it holds submodules, whose repositories would be deleted with it). Nothing else was touched"
      echo "removed worktree: $path"
      while read -r b tip; do
        if [ "$(git -C "$root" rev-parse --verify --quiet "refs/heads/$b")" != "$tip" ]; then
          echo "branch kept (moved since it was checked): $b"
        elif git -C "$root" branch -D "$b" >/dev/null 2>&1; then
          echo "deleted branch: $b (was ${tip:0:9})"
          deleted="${deleted:+$deleted$'\n'}$b"
        else
          echo "branch kept (checked out in another worktree?): $b"
        fi
      done <<< "$doomed"
    else
      # Ownership check BEFORE any removal (--force included): we only tear down
      # worktrees on the branch this tool would have created.
      [ "$live_branch" = "$expected_branch" ] \
        || die "refusing: $path is on branch '${live_branch:-detached}', expected '$expected_branch' — not ours to remove; clean up manually"

      git -C "$root" worktree remove ${force:+"$force"} "$path" \
        || die "worktree has changes — commit/stash them or rerun with --force"
      echo "removed worktree: $path"

      if git -C "$root" show-ref --verify --quiet "refs/heads/$expected_branch"; then
        if git -C "$root" branch -d "$expected_branch" 2>/dev/null; then
          echo "deleted branch: $expected_branch"
        else
          echo "branch kept (unmerged): $expected_branch — squash-merged? rerun as 'done --merged' next time; delete with: git -C \"$root\" branch -D $expected_branch"
        fi
      fi
    fi
    git -C "$root" worktree prune 2>/dev/null || true
  else
    echo "worktree already gone: $path — removing manifest row only (branch, if any, is untouched)"
  fi

  rewrite_manifest '$8 == " " p " " { next } { print }' -v p="$path"
  unlock
  echo "manifest row removed: $RESOLVED_REPO/$RESOLVED_SLUG"

  # Remote counterparts go last and outside the lock (network). Tips come from
  # origin itself, not from tracking refs that may be stale; one whose commit
  # is not even here cannot be proven landed and is kept. The lease pins each
  # delete to the tip just proven, so a concurrent push wins.
  [ -n "$deleted" ] || return 0
  local remote_heads
  remote_heads="$(GIT_TERMINAL_PROMPT=0 git -C "$root" ls-remote --heads origin 2>/dev/null)" \
    || { echo "remote branches left alone: can't list origin"; return 0; }
  while IFS= read -r b; do
    tip="$(printf '%s\n' "$remote_heads" | awk -v r="refs/heads/$b" '$2 == r { print $1 }')"
    [ -n "$tip" ] || continue
    if ! git -C "$root" cat-file -e "$tip^{commit}" 2>/dev/null || ! landed "$root" "$tip" "$trunk" "$head"; then
      echo "remote branch kept (has commits not on origin/$trunk_short): origin/$b"
    elif GIT_TERMINAL_PROMPT=0 git -C "$root" push --quiet --force-with-lease="refs/heads/$b:$tip" origin ":refs/heads/$b" 2>/dev/null; then
      echo "deleted remote branch: origin/$b"
    else
      echo "remote branch kept (delete rejected — moved, protected, or no push access): origin/$b"
    fi
  done <<< "$deleted"
}

# --- dispatch ------------------------------------------------------------------

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    new) cmd_new "$@" ;;
    register) cmd_register "$@" ;;
    status) cmd_status "$@" ;;
    list) cmd_list "$@" ;;
    resume) cmd_resume "$@" ;;
    done) cmd_done "$@" ;;
    -h|--help|help|"") usage 0 ;;
    *) die "unknown command: $cmd (try --help)" ;;
  esac
}

main "$@"
