#!/usr/bin/env bash
# claude-usage — one table of 5h/weekly limits across every Claude subscription
# you own, without logging in and out.
#
# Each account gets its own CLAUDE_CONFIG_DIR, which is what isolates the
# credential (Claude Code namespaces its keychain entry per config dir). A
# login's usage comes from `claude -p "/usage"`: no model turn, no quota spent,
# and its credential never leaves Claude Code. Token accounts differ; see below.
#
# Everything reads as headroom LEFT, and rows sort best-account-first for the
# model CLAUDE_USAGE_MODEL names (default fable): an account with any bucket
# that model draws on at 0 is unusable; the rest rank by their tightest bucket
# (session, week, and the model's own weekly bucket when it has one), then by
# weekly headroom. Accounts with missing measurements follow the measured
# ones; spent accounts come last, soonest weekly reset first.
#
# ~/.claude ("main") is a SLOT, not an account: whatever is logged into it is
# what a plain `claude` uses, and that changes whenever you log out and back in
# as someone else. Named accounts under the accounts root are the roster —
# each keeps its own login, so its identity never drifts. The table matches
# the slot to the roster by email, else (personal max/pro plans only, where an
# organization is one person) by organization id, and marks that account
# ACTIVE; a slot login nobody in the roster matches is listed as "main" until
# you `add` it.
#
#   claude-usage                 table for every account
#   claude-usage --json          machine-readable (statusline, cron)
#   claude-usage run [name|best] [claude args…]
#                                start claude on that account (default: best);
#                                any unique part of a name will do. `clu` is
#                                shorthand. Links this machine's ~/.claude stack
#                                (CLAUDE.md, AGENTS.md, statusline.sh,
#                                settings.json, plugins, skills) into the
#                                account first
#   claude-usage add <name>      store a `claude setup-token` token (pasted
#                                hidden, or piped on stdin — never an argument)
#   claude-usage add <name> --login [email]
#                                one-time interactive browser login instead
#   claude-usage show <name>     full /usage text, incl. what's burning the quota
#   claude-usage list            configured accounts
#   claude-usage remove <name>   forget an account (logs it out first)
#   claude-usage rename <a> <b>  relabel a roster account, credentials untouched
#   claude-usage best            which account to use right now, and why
#   claude-usage resolve <q>     the account key `run` would use (for scripts;
#                                exit 1 = "best" is only the least-bad pick)
#   other                        in run and resolve: the best account EXCEPT
#                                the one this shell is on — for offloading
#                                work; fails instead of falling back to it
#   =<key>                       in run and resolve: that exact account key,
#                                no name matching and no selector words (for
#                                scripts that recorded a key)
#   claude-usage current         the account this shell is on (its row in the
#                                table; exit 1 when it cannot be told)
#   claude-usage statusline      compact cached segment for statusline.sh
#   claude-usage refresh         re-probe every account into the snapshot cache
#
# Token accounts: a setup-token is inference-only (no user:profile scope), so
# /usage cannot read it. Instead ONE 1-token Fable request to api.anthropic.com
# returns the unified rate-limit headers (5h, 7d, and 7d_oi, the Fable week)
# plus the organization id. Each attempt, failed ones included, is reused for
# CLAUDE_USAGE_TTL. It spends a sliver of real quota and, on an idle account,
# opens its 5h window, so only explicit commands probe: the table, --json,
# show, best, and resolve/run when a reading is stale; the status line's
# background refresh reuses cached readings. CLAUDE_USAGE_PROBE_MODEL overrides
# the model; CLAUDE_USAGE_TOKEN_PROBE=0 turns the probe off.
#
# Accepted limits: the no-coreutils watchdog bounds the probe but not any
# grandchild it leaves behind; two refreshers can overlap if one is stolen from
# mid-claim (wasted work only — the snapshot swap is atomic); concurrent
# `rename` calls are last-writer-wins.

set -uo pipefail
unset CDPATH   # `cd x && pwd -P` must print one path, not cd's CDPATH echo too

ACCOUNTS_ROOT="${CLAUDE_ACCOUNTS_ROOT:-${HOME}/.claude-accounts}"
# Resolve before anything hashes or compares it: two worktrees each passing a
# relative "accounts" would otherwise share one snapshot and serve each other's
# numbers.
case "${ACCOUNTS_ROOT}" in
  /*) ;;
  *)  ACCOUNTS_ROOT="$(pwd -P)/${ACCOUNTS_ROOT}" ;;
esac
[[ -d ${ACCOUNTS_ROOT} ]] && ACCOUNTS_ROOT=$(cd "${ACCOUNTS_ROOT}" && pwd -P)
MAIN_DIR="${HOME}/.claude"
# Display names live here as "<dir-key>=<label>" rather than in the directory
# names themselves: Claude Code keys each keychain entry to the config dir PATH,
# so renaming a dir silently logs that account out (verified).
LABELS_FILE="${ACCOUNTS_ROOT}/labels.conf"
TIMEOUT="${CLAUDE_USAGE_TIMEOUT:-45}"
# A token account keeps its `claude setup-token` token here (0600) beside the
# day it was added. The CLI never reports a token's expiry; the docs give it a
# one-year life, so expiry is counted from the add date.
TOKEN_FILE="oauth-token"
TOKEN_DATE="oauth-token.added"
TOKEN_TTL=$((365 * 86400))
TOKEN_WARN_DAYS=30
# Fixed host on purpose: ANTHROPIC_BASE_URL could carry a token to a gateway.
PROBE_URL="https://api.anthropic.com/v1/messages"
# The Fable bucket header appears only for a request ON a Fable model.
PROBE_MODEL="${CLAUDE_USAGE_PROBE_MODEL:-claude-fable-5-1}"
PREMIUM_BUCKET="7d_oi" PREMIUM_LABEL="Fable"
TARGET_MODEL="${CLAUDE_USAGE_MODEL:-fable}"
# Everything that outranks a config dir's own login in Claude Code's auth
# precedence (cloud providers, bearer token, API key, apiKeyHelper's peers, the
# OAuth-token variable, Anthropic profiles), plus the endpoint and extra
# headers, which would carry the chosen account's credential to a leftover
# gateway. A caller's stray value would otherwise silently run as someone
# else. A settings.json `env` block or apiKeyHelper can still override; that is
# the user's own configuration.
AUTH_ENV=(ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
  ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS
  CLAUDE_CODE_OAUTH_REFRESH_TOKEN ANTHROPIC_PROFILE ANTHROPIC_FEDERATION_RULE_ID
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
  CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD
  CLAUDE_CODE_USE_MANTLE CLAUDE_CODE_USE_GATEWAY)
NEVER=999999999999   # sorts absent or unparseable resets to the bottom
SESSION_WINDOW=18300 # 5h plus 5 min of clock skew: no real session reset lies further ahead

# Snapshot cache. A status line renders constantly and must never pay for a
# 4-second probe, so it reads this file and refreshes in the background.
CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/claude-usage"
# A non-default account root is a different universe of accounts; sharing one
# snapshot between roots would serve each the other's numbers.
[[ ${ACCOUNTS_ROOT} != "${HOME}/.claude-accounts" ]] &&
  CACHE_DIR="${CACHE_DIR}/$(printf '%s' "${ACCOUNTS_ROOT}" | cksum | cut -d' ' -f1)"
# v3 holds login rows only, with org id and observation time.
SNAPSHOT="${CACHE_DIR}/snapshot.v3.tsv"
LOCK_DIR="${CACHE_DIR}/refresh.lock"
TTL="${CLAUDE_USAGE_TTL:-600}"

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; YEL=$'\033[33m'
  GRN=$'\033[32m'; RST=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; YEL=''; GRN=''; RST=''
fi

die() { printf '%s\n' "$*" >&2; exit 1; }

UNKNOWN='?'   # rejected by valid_name, so no real account can collide with it

# Names become path components and JSON strings, so a leading dot (".."), a
# quote, or a tab are all disqualifying. "<dir>.lock" is the lockfile Claude
# Code keeps beside a config dir; one can outlive the session that took it.
valid_name() { [[ $1 =~ ^[A-Za-z0-9._-]+$ && $1 != .* && $1 != *.lock ]]; }

command -v claude > /dev/null || die "claude CLI not on PATH"

# Directory key -> display label. The slot is always "main": its display name
# comes from the roster account matched to it, never from an alias.
label_for() {
  local key="$1" k v
  [[ ${key} == main ]] && { printf 'main'; return; }
  if [[ -f ${LABELS_FILE} ]]; then
    while IFS='=' read -r k v || [[ -n ${k} ]]; do
      [[ ${k} == "${key}" && -n ${v} ]] && { printf '%s' "${v}"; return; }
    done < "${LABELS_FILE}"
  fi
  printf '%s' "${key}"
}

# Display label -> directory key. Falls through unchanged so every command
# accepts either name.
key_for() {
  local want="$1" k v
  if [[ -f ${LABELS_FILE} ]]; then
    while IFS='=' read -r k v || [[ -n ${k} ]]; do
      [[ ${k} == main ]] && continue   # a pre-roster alias for the slot; ignored
      [[ ${v} == "${want}" && -n ${k} ]] && { printf '%s' "${k}"; return; }
    done < "${LABELS_FILE}"
  fi
  printf '%s' "${want}"
}

# Every account dir, as "<name>\t<config-dir>".
account_rows() {
  [[ -d ${MAIN_DIR} && -z ${CLAUDE_USAGE_SKIP_MAIN:-} ]] && printf '%s\t%s\n' "$(label_for main)" "${MAIN_DIR}"
  [[ -d ${ACCOUNTS_ROOT} ]] || return 0
  local dir key
  for dir in "${ACCOUNTS_ROOT}"/*/; do
    [[ -d ${dir} ]] || continue
    # A symlinked home aliases another account or the slot; `run` refuses it.
    [[ -L ${dir%/} ]] && continue
    key=$(basename "${dir}")
    valid_name "${key}" || continue
    printf '%s\t%s\n' "$(label_for "${key}")" "${dir%/}"
  done
}

resolve_dir() {
  local key; key=$(key_for "$1")
  valid_name "${key}" || die "invalid account name: $1"
  [[ ${key} == main ]] && { printf '%s' "${MAIN_DIR}"; return 0; }
  [[ -d ${ACCOUNTS_ROOT}/${key} ]] || die "unknown account: $1 (try: claude-usage list)"
  printf '%s' "${ACCOUNTS_ROOT}/${key}"
}

is_token() { [[ $1 != main && -f ${ACCOUNTS_ROOT}/$1/${TOKEN_FILE} ]]; }

# Whole days until a token account's token expires: negative once it has,
# "?" when the add date is missing or unreadable (never treated as expired).
token_days_left() {
  local added="" secs
  { IFS= read -r added || [[ -n ${added} ]]; } < "${ACCOUNTS_ROOT}/$1/${TOKEN_DATE}" 2> /dev/null
  [[ ${added} =~ ^[0-9]+$ ]] || { printf '?'; return; }
  secs=$((added + TOKEN_TTL - $(date +%s)))
  if ((secs > 0)); then printf '%s' "$((secs / 86400))"; else printf '%s' "$((-1 - (-secs) / 86400))"; fi
}

# Epoch -> formatted date. GNU first: GNU's -r reads a FILE's mtime, so a file
# named like the number would answer for it.
fmt_epoch() { date -d "@$1" "+$2" 2> /dev/null || date -r "$1" "+$2" 2> /dev/null; }

token_expiry() {
  local added=""
  { IFS= read -r added || [[ -n ${added} ]]; } < "${ACCOUNTS_ROOT}/$1/${TOKEN_DATE}" 2> /dev/null
  [[ ${added} =~ ^[0-9]+$ ]] || { printf 'unknown'; return; }
  fmt_epoch "$((added + TOKEN_TTL))" "$2"
}

lower() { tr '[:upper:]' '[:lower:]' <<< "$1"; }

# Account query -> directory key, "main" for the slot. Exact names win; any
# other query must be part of exactly one roster name, so `clu proton` reaches
# alejo-proton without the prefix.
resolve_key() {
  local q="$1" key lq dir name n=0 found="" all=""
  [[ ${q} == main ]] && { printf 'main'; return 0; }
  # A directory key beats a label spelling the same name, so a key recorded by
  # a script can never be redirected by a later rename.
  for key in "${q}" "$(key_for "${q}")"; do
    if valid_name "${key}" && [[ -d ${ACCOUNTS_ROOT}/${key} ]]; then printf '%s' "${key}"; return 0; fi
  done
  lq=$(lower "${q}")
  for dir in "${ACCOUNTS_ROOT}"/*/; do
    [[ -d ${dir} && ! -L ${dir%/} ]] || continue
    key=$(basename "${dir}")
    valid_name "${key}" || continue
    name=$(label_for "${key}")
    [[ $(lower "${name}") == *"${lq}"* ]] || continue
    n=$((n + 1)); found="${key}"; all="${all} ${name}"
  done
  ((n == 1)) && { printf '%s' "${found}"; return 0; }
  ((n == 0)) && die "unknown account: ${q} (try: claude-usage list)"
  die "ambiguous: ${q} matches${all} — be more specific"
}

# A usage line is "<label>: N% used · resets <when> (<tz>)", except the reset
# clause is absent for a bucket with no window open yet. Both parsers fall back
# to "-" rather than leaking the unmatched line into the column.
parse_left() {
  local pct
  pct=$(sed -E 's/.*: *([0-9]+)% used.*/\1/' <<< "$1")
  [[ ${pct} =~ ^[0-9]+$ ]] || { printf -- '-'; return; }
  pct=$((10#${pct}))
  ((pct > 100)) && pct=100
  printf '%s' "$((100 - pct))"
}

parse_reset() {
  [[ $1 == *"resets "* ]] || { printf -- '-'; return; }
  sed -E 's/.*resets ([^(]*)\(?.*/\1/' <<< "$1" | sed 's/ *$//'
}

# Parse "<mon> <day> <time>" against an explicit year, under either date
# flavour: BSD wants -j -f <fmt>, GNU wants -d.
parse_when() {
  local s="$1" y="$2" fmt out
  for fmt in "%b %d %I:%M:%S%p %Y" "%b %d %I:%M%p %Y" "%b %d %I%p %Y" "%b %d %H:%M:%S %Y" "%b %d %H:%M %Y"; do
    out=$(date -j -f "${fmt}" "${s} ${y}" +%s 2> /dev/null)
    if [[ ${out} =~ ^[0-9]+$ ]]; then printf '%s' "${out}"; return 0; fi
  done
  out=$(date -d "${s} ${y}" +%s 2> /dev/null)
  if [[ ${out} =~ ^[0-9]+$ ]]; then printf '%s' "${out}"; return 0; fi
  return 1
}

# "Sep 19 at 6am" → epoch, for ordering by which window frees up first.
to_epoch() {
  local when="$1" norm now year out
  [[ -z ${when} || ${when} == "-" ]] && { printf '%s' "${NEVER}"; return; }
  # Older CLIs print "Sep 19 at 6am", newer ones "Sep 19, 6am"; date(1)
  # rejects the comma.
  norm=${when/ at / }; norm=${norm//,/}
  # BSD date fills unspecified fields from the current clock, so a bare "6am"
  # would inherit this minute and seconds. Pin them.
  norm=$(sed -E -e 's/ ([0-9]{1,2})(am|pm)$/ \1:00\2/' -e 's/ ([0-9]{1,2}):([0-9]{2})(am|pm)$/ \1:\2:00\3/' <<< "${norm}")
  now=$(date +%s); year=$(date +%Y)
  out=$(parse_when "${norm}" "${year}") || { printf '%s' "${NEVER}"; return; }
  # Reset strings carry no year, so a "Jan 2" read on Dec 30 parses as THIS
  # January — a year overdue, which would sort it first and recommend the wrong
  # account. Every real reset is within 7 days ahead, so anything well behind
  # now is that rollover, not a genuinely elapsed window.
  if ((out < now - 172800)); then
    out=$(parse_when "${norm}" "$((year + 1))") || { printf '%s' "${NEVER}"; return; }
  fi
  printf '%012d' "${out}"
}

# Headroom, not consumption: red is the "about to be cut off" band.
paint_left() {
  local left="$1" colour
  [[ ${left} == "-" ]] && { printf '%s-%s' "${DIM}" "${RST}"; return; }
  if   ((left <= 15)); then colour="${RED}"
  elif ((left <= 50)); then colour="${YEL}"
  else                      colour="${GRN}"
  fi
  printf '%s%s%%%s' "${colour}" "${left}" "${RST}"
}

# Run the CLI against one account. CLAUDE_CONFIG_DIR namespaces the keychain
# entry, so the primary account is only reachable with the variable UNSET —
# exporting it, even pointed at ~/.claude, looks like a different account.
# Bounded execution without coreutils. Polls in one-second steps instead of
# sleeping for the whole timeout, so when the probe finishes normally the
# watchdog notices and exits by itself — killing the subshell would orphan a
# long sleep, and a burst of probes would leave a pile of them behind.
watchdog() {
  local pid rc
  "$@" &
  pid=$!
  # stdout MUST be closed here: run_claude runs inside $(...), and command
  # substitution blocks until every process holding that pipe exits.
  (
    waited=0
    while ((waited < TIMEOUT)); do
      kill -0 "${pid}" 2> /dev/null || exit 0
      sleep 1
      waited=$((waited + 1))
    done
    kill -TERM "${pid}" 2> /dev/null || exit 0
    # Poll rather than sleeping blind: the target usually dies on TERM, and an
    # unconditional KILL five seconds later can land on a recycled pid.
    grace=0
    while ((grace < 5)); do
      kill -0 "${pid}" 2> /dev/null || exit 0
      sleep 1
      grace=$((grace + 1))
    done
    kill -KILL "${pid}" 2> /dev/null
  ) > /dev/null 2>&1 &
  wait "${pid}"; rc=$?
  return "${rc}"
}

run_claude() {
  local dir="$1"; shift
  local -a runner=() envcmd=(env)
  local v
  for v in "${AUTH_ENV[@]}"; do envcmd+=(-u "${v}"); done
  # A stock macOS has no `timeout`; watchdog() is the fallback, because an
  # unbounded probe would hang gather forever and, since its pid stays alive,
  # make the refresh lock permanently unreclaimable.
  command -v timeout > /dev/null && runner=(timeout -k 5 "${TIMEOUT}")
  if [[ ${dir} == "${MAIN_DIR}" ]]; then
    # -u, not merely "don't set it": a refresh spawned from a session running
    # under another account would otherwise inherit that account and probe it
    # a second time under the name "main".
    envcmd+=(-u CLAUDE_CONFIG_DIR)
  else
    envcmd+=("CLAUDE_CONFIG_DIR=${dir}")
  fi
  if ((${#runner[@]})); then
    "${runner[@]}" "${envcmd[@]}" claude "$@" < /dev/null
  else
    watchdog "${envcmd[@]}" claude "$@" < /dev/null
  fi
}

# Without --no-session-persistence every probe saves a transcript into the
# account's projects/, one per account per refresh. --safe-mode keeps auth but
# skips hooks and plugins, which a linked settings.json would otherwise fire on
# every probe; it also halves the probe time.
usage_text() {
  run_claude "$1" -p "/usage" --safe-mode --allowed-tools "" --no-session-persistence
}

token_cache() { printf '%s/token-%s.tsv' "${CACHE_DIR}" "$1"; }
# The organization a token answered for, as "<gen>\t<org>": identity, kept
# apart from readings so a failed probe never forgets it.
token_org_file() { printf '%s/token-%s.org' "${CACHE_DIR}" "$1"; }

# Shell tracing would print a token verbatim, so every line holding one runs
# between these; the depth count keeps a nested pair from re-enabling early.
XT_DEPTH=0 XT_WAS=0
xtrace_off() { [[ $- == *x* ]] && XT_WAS=1; { set +x; } 2> /dev/null; XT_DEPTH=$((XT_DEPTH + 1)); }
xtrace_restore() {
  XT_DEPTH=$((XT_DEPTH - 1))
  ((XT_DEPTH == 0 && XT_WAS)) && { XT_WAS=0; set -x; }
  return 0
}

# Which credential a reading belongs to, without reading the credential: a
# re-added token is a new file (new inode and mtime), so its old readings and
# organization stop applying.
token_gen() {
  local f="${ACCOUNTS_ROOT}/$1/${TOKEN_FILE}" g
  g=$(stat -c '%i:%Y:%s' "${f}" 2> /dev/null)
  [[ ${g} =~ ^[0-9]+:[0-9]+:[0-9]+$ ]] || g=$(stat -f '%i:%m:%z' "${f}" 2> /dev/null)
  [[ ${g} =~ ^[0-9]+:[0-9]+:[0-9]+$ ]] || { printf -- '-'; return; }
  printf '%s' "${g}" | cksum | cut -d' ' -f1
}

token_org() {
  local g="" o="" f
  f=$(token_org_file "$1")
  [[ -f ${f} ]] && IFS=$'\t' read -r g o < "${f}"
  if [[ ${g} == "$(token_gen "$1")" && ${o} =~ ^[A-Za-z0-9_-]+$ ]]; then printf '%s' "${o}"; else printf -- '-'; fi
}

# Epoch -> the CLI's own reset spelling ("Oct 12 at 5am"), which to_epoch and
# reset_day already read.
fmt_reset() {
  [[ $1 =~ ^[0-9]+$ ]] || { printf -- '-'; return; }
  fmt_epoch "$1" '%b %-d at %-I:%M%p' | sed -E -e 's/AM$/am/' -e 's/PM$/pm/' -e 's/:00(am|pm)$/\1/'
}

# Utilization fraction ("0.34") -> whole percent LEFT, "-" when unparseable.
frac_left() {
  [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] || { printf -- '-'; return; }
  awk -v u="$1" 'BEGIN { l = 100 - int(u * 100 + 0.5); if (l < 0) l = 0; printf "%d", l }'
}

# A token reading, one line: "gen model obs result org s_left s_reset s_status
# w_left w_reset w_status p_left p_reset p_status reason", every empty field
# "-" (read collapses adjacent tabs). result: ok, rejected (429: numbers kept),
# dead (credential refused), failed (no numbers), none (never probed). Prints
# nothing when the cached line belongs to another credential or model.
token_read() {
  local f g m
  f=$(token_cache "$1")
  [[ -f ${f} ]] || return 1
  IFS=$'\t' read -r g m _ < "${f}"
  [[ ${g} == "$(token_gen "$1")" && ${m} == "${PROBE_MODEL}" ]] || return 1
  cat "${f}"
}

token_none() {
  printf '%s\t%s\t0\tnone\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t%s\n' "$(token_gen "$1")" "${PROBE_MODEL}" "$2"
}

reading_fresh() {
  local obs
  IFS=$'\t' read -r _ _ obs _ <<< "$1"
  [[ ${obs} =~ ^[0-9]+$ ]] && (($(date +%s) - obs <= TTL))
}

# The reading for a token account: cached when younger than TTL (a failed
# attempt included, so failures back off for one TTL), else one probe, one
# prober per account at a time. $2=cached never probes.
token_probe() {
  local key="$1" mode="${2:-live}" rec lock me holder deadline
  rec=$(token_read "${key}")
  if [[ -n ${rec} ]] && { [[ ${mode} == cached ]] || reading_fresh "${rec}"; }; then
    printf '%s\n' "${rec}"; return
  fi
  [[ ${mode} == cached ]] && { token_none "${key}" "not probed yet — run: claude-usage"; return; }
  if [[ ${CLAUDE_USAGE_TOKEN_PROBE:-1} == 0 ]]; then
    if [[ -n ${rec} ]]; then printf '%s\n' "${rec}"; else token_none "${key}" "usage probe off (CLAUDE_USAGE_TOKEN_PROBE=0)"; fi
    return
  fi
  if ! mkdir -p "${CACHE_DIR}" 2> /dev/null || [[ ! -w ${CACHE_DIR} ]]; then
    token_none "${key}" "cache dir not writable: ${CACHE_DIR}"; return
  fi
  lock="$(token_cache "${key}").lock"
  # $$ is the top-level shell even in a subshell; this is the process itself.
  me=$(exec sh -c 'echo "$PPID"')
  deadline=$(($(date +%s) + TIMEOUT + 15))
  until mkdir "${lock}" 2> /dev/null; do
    if (($(date +%s) >= deadline)); then
      if [[ -n ${rec} ]]; then printf '%s\n' "${rec}"; else token_none "${key}" "another probe is still running"; fi
      return
    fi
    if [[ -d ${lock} ]]; then
      holder=$(cat "${lock}/pid" 2> /dev/null)
      # A prober killed mid-request leaves its lock; curl is bounded by TIMEOUT.
      if { [[ ${holder} =~ ^[0-9]+$ ]] && ! kill -0 "${holder}" 2> /dev/null; } ||
        (($(file_age "${lock}") > TIMEOUT + 15)); then
        lock_reclaim "${lock}" "${holder}" "${me}"
        continue
      fi
    fi
    sleep 1
  done
  printf '%s' "${me}" > "${lock}/pid"
  rec=$(token_read "${key}")
  if [[ -n ${rec} ]] && reading_fresh "${rec}"; then
    printf '%s\n' "${rec}"
  else
    token_fetch "${key}"
  fi
  lock_release "${lock}" "${me}"
}

# Take a stale lock only if it is still the one judged stale: mv is atomic,
# and the grave's pid says whose it was. Someone else's fresh lock goes back.
# Accepted race: two reclaimers judging the same stale owner can displace each
# other's fresh lock, bounded to one duplicate 1-token probe; readings are
# per-account files swapped atomically, so nothing is corrupted or exposed.
lock_reclaim() {
  local lock="$1" holder="$2" me="$3" grave="$1.dead.$3"
  mv "${lock}" "${grave}" 2> /dev/null || return 0
  if [[ $(cat "${grave}/pid" 2> /dev/null) != "${holder}" && ! -e ${lock} ]]; then
    mv "${grave}" "${lock}" 2> /dev/null
  fi
  rm -rf "${grave}"
}

lock_release() { [[ $(cat "$1/pid" 2> /dev/null) == "$2" ]] && rm -rf "$1"; return 0; }

# One 1-token Fable request: /api/oauth/usage refuses a setup-token (needs
# user:profile), but a subscription token's /v1/messages replies carry the
# unified rate-limit headers. Writes and prints the reading.
token_fetch() {
  local key="$1" tok="" out line n v code="" cexit="" body gen tmp f
  local org="-" s="" sr="" ss="" w="" wr="" ws="" p="" pr="" ps="" us="" result=failed reason=""
  gen=$(token_gen "${key}")
  if ! command -v curl > /dev/null; then
    token_none "${key}" "curl not on PATH"; return
  elif [[ ! ${PROBE_MODEL} =~ ^[A-Za-z0-9._-]+$ ]]; then
    token_none "${key}" "invalid CLAUDE_USAGE_PROBE_MODEL"; return
  fi
  # Subscription OAuth on /v1 wants the Claude Code identity prompt.
  body=$(printf '{"model":"%s","max_tokens":1,"system":"You are Claude Code, Anthropic%ss official CLI for Claude.","messages":[{"role":"user","content":"."}]}' "${PROBE_MODEL}" "'")
  xtrace_off
  { IFS= read -r tok || [[ -n ${tok} ]]; } < "${ACCOUNTS_ROOT}/${key}/${TOKEN_FILE}"
  if [[ ${tok} =~ ^sk-ant-oat[0-9]+-[A-Za-z0-9_-]+$ ]]; then
    # The token reaches curl as a config on stdin (printf is a builtin), never
    # argv. -q skips ~/.curlrc (a -v or trace there would log the header); no
    # proxy, CA override or TLS key log may see or weaken the request.
    out=$(printf 'header = "Authorization: Bearer %s"\n' "${tok}" |
      env -u SSLKEYLOGFILE -u CURL_CA_BUNDLE -u SSL_CERT_FILE -u SSL_CERT_DIR -u CURL_HOME \
        curl -q -sS --noproxy '*' --proto =https --max-time "${TIMEOUT}" -K - \
        -H 'anthropic-version: 2023-06-01' -H 'anthropic-beta: oauth-2025-04-20' \
        -H 'content-type: application/json' --data "${body}" \
        -o /dev/null -D - -w '\n%{http_code}\n' "${PROBE_URL}" 2> /dev/null
      printf 'curl-exit %s\n' "${PIPESTATUS[1]}")
    tok=""
    xtrace_restore
  else
    tok=""
    xtrace_restore
    result=dead reason="token file unreadable — run: claude-usage add $(label_for "${key}")"
  fi

  shopt -s nocasematch
  while IFS= read -r line; do
    line=${line%$'\r'}
    # Each status line starts a block; only the final reply's headers count.
    if [[ ${line} == HTTP/* ]]; then
      org="-" s="" sr="" ss="" w="" wr="" ws="" p="" pr="" ps="" us=""
      continue
    fi
    [[ ${line} =~ ^[0-9]{3}$ ]] && { code=${line}; continue; }
    [[ ${line} =~ ^curl-exit\ ([0-9]+)$ ]] && { cexit=${BASH_REMATCH[1]}; continue; }
    [[ ${line} == *:* ]] || continue
    n=${line%%:*}; v=${line#*:}
    v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
    case ${n} in
      anthropic-organization-id)                     org=${v} ;;
      anthropic-ratelimit-unified-status)            us=${v} ;;
      anthropic-ratelimit-unified-5h-utilization)    s=${v} ;;
      anthropic-ratelimit-unified-5h-reset)          sr=${v} ;;
      anthropic-ratelimit-unified-5h-status)         ss=${v} ;;
      anthropic-ratelimit-unified-7d-utilization)    w=${v} ;;
      anthropic-ratelimit-unified-7d-reset)          wr=${v} ;;
      anthropic-ratelimit-unified-7d-status)         ws=${v} ;;
      "anthropic-ratelimit-unified-${PREMIUM_BUCKET}-utilization") p=${v} ;;
      "anthropic-ratelimit-unified-${PREMIUM_BUCKET}-reset")       pr=${v} ;;
      "anthropic-ratelimit-unified-${PREMIUM_BUCKET}-status")      ps=${v} ;;
    esac
  done <<< "${out:-}"
  shopt -u nocasematch

  # A refusal counts whatever else the reply lacks; anything else is ok only
  # from a transfer curl completed, with a 2xx and both core buckets.
  if [[ ${result} != dead ]]; then
    if [[ ${code} == 401 ]]; then
      result=dead reason="token rejected (HTTP 401) — mint a new one (claude setup-token), then: claude-usage add $(label_for "${key}")"
    elif [[ ${code} == 429 || ${us} == rejected || ${ss} == rejected || ${ws} == rejected || ${ps} == rejected ]]; then
      result=rejected
    elif [[ -z ${code} || ${code} == 000 ]]; then
      reason="api.anthropic.com unreachable (curl exit ${cexit:-?})"
    elif [[ ${cexit} != 0 ]]; then
      reason="transfer failed after HTTP ${code} (curl exit ${cexit:-?})"
    elif [[ ${code} != 2?? ]]; then
      reason="HTTP ${code} from the API"
    elif [[ $(frac_left "${s}") != "-" && $(frac_left "${w}") != "-" ]]; then
      result=ok
    else
      reason="HTTP ${code} without rate-limit headers"
    fi
  fi
  [[ ${org} =~ ^[A-Za-z0-9_-]+$ ]] || org="-"
  for v in ss ws ps; do [[ ${!v} =~ ^[a-z_]+$ ]] || printf -v "${v}" '%s' "-"; done
  for v in sr wr pr; do [[ ${!v} =~ ^[0-9]+$ ]] || printf -v "${v}" '%s' "-"; done
  if [[ ${result} == ok || ${result} == rejected ]]; then
    s=$(frac_left "${s}"); w=$(frac_left "${w}"); p=$(frac_left "${p}")
    if [[ ${org} != "-" ]]; then
      f=$(token_org_file "${key}")
      printf '%s\t%s\n' "${gen}" "${org}" > "${f}.$$" && mv -f "${f}.$$" "${f}"
    fi
  else
    s="-" sr="-" ss="-" w="-" wr="-" ws="-" p="-" pr="-" ps="-"
  fi
  line=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "${gen}" "${PROBE_MODEL}" \
    "$(date +%s)" "${result}" "${org}" "${s}" "${sr}" "${ss}" "${w}" "${wr}" "${ws}" "${p}" "${pr}" "${ps}" "${reason:--}")
  tmp="$(token_cache "${key}").$$"
  printf '%s\n' "${line}" > "${tmp}" && mv -f "${tmp}" "$(token_cache "${key}")"
  printf '%s\n' "${line}"
}

# Rows from TOKEN_MODE=cached (the status line's background refresh) reuse
# readings only; any other refresh may probe.
TOKEN_MODE=live
[[ ${_CLAUDE_USAGE_PASSIVE:-} == 1 ]] && TOKEN_MODE=cached

# A row per account, led by a sort key: "key name email plan s_left s_reset
# w_left w_reset p_label p_left active org observed note", note last because
# only it may be empty.
# A reading's headroom LEFT as "session \t week \t premium", "-" unmeasured. A
# refused bucket is spent whatever its utilization says, measured or not; a
# refusal that names none is the whole account refusing. Args: result, then
# value and status for session, week, premium.
token_norm() {
  local r="$1" s="$2" ss="$3" w="$4" ws="$5" p="$6" ps="$7" named=0
  [[ ${ss} == rejected ]] && { s=0; named=1; }
  [[ ${ws} == rejected ]] && { w=0; named=1; }
  [[ ${ps} == rejected ]] && { p=0; named=1; }
  [[ ${r} == rejected ]] && ((!named)) && { s=0; w=0; p=0; }
  printf '%s\t%s\t%s\n' "${s}" "${w}" "${p}"
}

# "N% used" from headroom left, or "unknown".
pct_used() { if [[ $1 =~ ^[0-9]+$ ]]; then printf '%s%% used' "$((100 - $1))"; else printf 'unknown'; fi; }

# One row for a token account from its reading; $3=cached never probes. /usage
# cannot read a token (inference-only): token_probe reads the rate-limit
# headers instead.
token_row() {
  local name="$1" k="$2" mode="$3" obs result org key note
  local s_left s_reset s_st w_left w_reset w_st p_label p_left p_st
  if [[ $(token_days_left "${k}") == -* ]]; then
    printf '%s\t%s\t-\ttoken\t-\t-\t-\t-\t-\t-\t0\t-\t0\ttoken expired — run: claude-usage add %s\n' \
      "${NEVER}" "${name}" "${name}"
    return
  fi
  IFS=$'\t' read -r _ _ obs result _ s_left s_reset s_st w_left w_reset w_st p_left _ p_st note \
    < <(token_probe "${k}" "${mode}")
  org=$(token_org "${k}")
  case ${result} in
    dead)
      printf '%s\t%s\t-\ttoken\t-\t-\t-\t-\t-\t-\t0\t%s\t%s\t%s\n' "${NEVER}" "${name}" "${org}" "${obs}" "${note}"
      ;;
    ok | rejected)
      IFS=$'\t' read -r s_left w_left p_left \
        < <(token_norm "${result}" "${s_left}" "${s_st}" "${w_left}" "${w_st}" "${p_left}" "${p_st}")
      p_label="-"; [[ ${p_left} != "-" ]] && p_label=${PREMIUM_LABEL}
      key=$(printf '%03d%012d' "$((100 - ${p_left//-/0}))" "${w_reset//-/${NEVER}}")
      printf '%s\t%s\t-\ttoken\t%s\t%s\t%s\t%s\t%s\t%s\t0\t%s\t%s\t\n' "${key}" "${name}" \
        "${s_left}" "$(fmt_reset "${s_reset}")" "${w_left}" "$(fmt_reset "${w_reset}")" \
        "${p_label}" "${p_left}" "${org}" "${obs}"
      ;;
    *)
      # After every account with readable headroom, before the unusable ones.
      printf '998%s\t%s\t-\ttoken\t-\t-\t-\t-\t-\t-\t0\t%s\t%s\t\n' "${NEVER}" "${name}" "${org}" "${obs}"
      ;;
  esac
}

probe() {
  local name="$1" dir="$2" auth email plan usage line org obs
  local s_left s_reset w_left w_reset p_label p_left key

  obs=$(date +%s)
  auth=$(run_claude "${dir}" auth status --json 2> /dev/null)
  if [[ ${auth} != *'"loggedIn": true'* ]]; then
    printf '%s\t%s\t-\t-\t-\t-\t-\t-\t-\t-\t0\t-\t%s\tlogged out — run: claude-usage add %s --login (or paste a setup-token)\n' \
      "${NEVER}" "${name}" "${obs}" "${name}"
    return
  fi

  email=$(sed -n 's/.*"email": "\([^"]*\)".*/\1/p' <<< "${auth}" | head -1)
  plan=$(sed -n 's/.*"subscriptionType": "\([^"]*\)".*/\1/p' <<< "${auth}" | head -1)
  org=$(sed -n 's/.*"orgId": "\([A-Za-z0-9_-]*\)".*/\1/p' <<< "${auth}" | head -1)

  usage=$(usage_text "${dir}" 2> /dev/null)
  obs=$(date +%s)   # when /usage answered: pairing compares it with token readings
  # A subscription login that lists no windows has none open: nothing spent
  # this week, so every bucket is full. The premium bucket's name is unknown.
  # A busy account occasionally gets one windowless reply too, so an idle
  # reading must repeat before it is believed.
  [[ ${usage} == *"using your subscription"* && ${usage} != *"Current "* ]] &&
    usage=$(usage_text "${dir}" 2> /dev/null)
  if [[ ${usage} == *"using your subscription"* && ${usage} != *"Current "* ]]; then
    printf '000%s\t%s\t%s\t%s\t100\tidle\t100\tidle\t-\t100\t0\t%s\t%s\t\n' \
      "${NEVER}" "${name}" "${email:--}" "${plan:--}" "${org:--}" "${obs}"
    return
  fi
  if [[ -z ${usage} || ${usage} != *"Current session:"* ]]; then
    printf '%s\t%s\t%s\t%s\t-\t-\t-\t-\t-\t-\t0\t%s\t%s\tno usage data (API-key auth or CLI error)\n' \
      "${NEVER}" "${name}" "${email:--}" "${plan:--}" "${org:--}" "${obs}"
    return
  fi

  line=$(grep -m1 "Current session:" <<< "${usage}")
  s_left=$(parse_left "${line}"); s_reset=$(parse_reset "${line}")

  line=$(grep -m1 "Current week (all models)" <<< "${usage}")
  w_left=$(parse_left "${line}"); w_reset=$(parse_reset "${line}")

  # The second weekly bucket is named after whichever premium model the plan
  # meters separately (Opus, Fable, …), so read the label rather than assume it.
  line=$(grep "Current week (" <<< "${usage}" | grep -v "all models" | head -1)
  if [[ -n ${line} ]]; then
    p_label=$(sed -E 's/.*Current week \(([^)]*)\).*/\1/' <<< "${line}")
    p_left=$(parse_left "${line}")
  else
    p_label="-"; p_left="-"
  fi

  key=$(printf '%03d%s' "$((100 - ${p_left//-/0}))" "$(to_epoch "${w_reset}")")

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t0\t%s\t%s\t\n' \
    "${key}" "${name}" "${email:--}" "${plan:--}" \
    "${s_left:--}" "${s_reset:--}" "${w_left:--}" "${w_reset:--}" \
    "${p_label:--}" "${p_left:--}" "${org:--}" "${obs}"
}

# Resolve the slot against the roster. The "main" row and a roster row sharing
# an email are the same account seen through two logins: keep the roster row
# (that is the name the user chose), mark it active, and give it the slot's
# live /usage numbers. A token carries no email, so on a personal plan (max or
# pro: the organization is one person) a single roster row whose organization
# id equals the slot's matches too; on team or enterprise plans many people
# share one, so it never does. No match → the slot stays as "main", active, so
# the numbers are still shown.
mark_active() {
  local rows line key name email plan sl sr wl wr pl pv active org obs note o so
  local main_email="-" main_org="-" main_plan="" matched="" hits=0 slot=""
  rows=$(cat)
  while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
    [[ ${name} == main ]] && { main_email="${email}"; main_org="${org}"; main_plan="${plan}"; break; }
  done <<< "${rows}"
  if [[ -n ${main_email} && ${main_email} != "-" ]]; then
    while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
      [[ ${name} != main && ${email} == "${main_email}" ]] && { matched="${name}"; break; }
    done <<< "${rows}"
  fi
  if [[ -z ${matched} && -n ${main_org} && ${main_org} != "-" ]] && [[ ${main_plan} == max || ${main_plan} == pro ]]; then
    while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
      [[ ${name} != main && ${org} == "${main_org}" ]] && { matched="${name}"; hits=$((hits + 1)); }
    done <<< "${rows}"
    ((hits == 1)) || matched=""
  fi
  # A revoked or expired roster credential must not hide the slot's working
  # login: the slot stays the launch target.
  if [[ -n ${matched} ]] && awk -F'\t' -v m="${matched}" '$2 == m && $14 != ""' <<< "${rows}" | grep -q .; then
    matched=""
  fi
  [[ -n ${matched} ]] && slot=$(awk -F'\t' '$2 == "main" && $14 == "" && $7 != "-"' <<< "${rows}" | head -1)
  while IFS= read -r line; do
    [[ -z ${line} ]] && continue
    IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note <<< "${line}"
    if [[ ${name} == main ]]; then
      [[ -n ${matched} ]] && continue
      active=1
    elif [[ ${name} == "${matched}" ]]; then
      active=1
      # The slot's numbers replace the row's only when they are the newer
      # observation: an older login reading must not undo a newer refusal.
      if [[ -n ${slot} && -z ${note} ]]; then
        IFS=$'\t' read -r _ _ _ _ _ _ _ _ _ _ _ o so _ <<< "${slot}"
        [[ ${org} == "-" ]] && org="${o}"
        if [[ ${so} =~ ^[0-9]+$ ]] && { [[ ! ${obs} =~ ^[0-9]+$ ]] || ((so > obs)); }; then
          IFS=$'\t' read -r key _ email _ sl sr wl wr pl pv _ _ obs _ <<< "${slot}"
        fi
      fi
    else
      active=0
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${key}" "${name}" "${email}" "${plan}" \
      "${sl}" "${sr}" "${wl}" "${wr}" "${pl}" "${pv}" "${active}" "${org}" "${obs}" "${note}"
  done <<< "${rows}"
}

# Rows -> "tier \t row", best first, for the model TARGET_MODEL names. Tier 0:
# every applicable bucket measured and none spent, ranked by the tightest one,
# then weekly headroom, then sort key. Tier 1: nothing known spent, something
# unmeasured. Tier 2: a known spent bucket, soonest weekly reset first. Tier
# 3: a note (logged out, refused, expired). The target decides which buckets
# are required, not what a reading happened to return: a Fable target needs
# the Fable week, so a row without it is unknown, never fully measured.
rank_rows() {
  awk -F'\t' -v OFS='\t' -v t="$(lower "${TARGET_MODEL}")" -v pf="$(lower "${PREMIUM_LABEL}")" '
    function num(x) { return x ~ /^[0-9]+$/ }
    NF {
      sl = $5; wl = $7; pl = tolower($9); pv = $10
      req = ""
      if (index(t, pf)) req = pf
      else if (pl != "-" && pl != "" && index(t, pl)) req = pl
      # An idle login has no window open anywhere: every bucket is full.
      have = (req != "" && num(pv) && (pl == req || $8 == "idle"))
      a = 0; b = 0; c = $1
      if ($14 != "") tier = 3
      else if ((num(sl) && sl == 0) || (num(wl) && wl == 0) || (have && pv == 0)) { tier = 2; c = substr($1, 4) }
      else if (num(sl) && num(wl) && (req == "" || have)) {
        tier = 0; m = sl + 0; if (wl + 0 < m) m = wl + 0; if (have && pv + 0 < m) m = pv + 0
        a = 100 - m; b = 100 - wl
      } else tier = 1
      printf "%d\t%03d\t%03d\t%s\t%d\t%s\n", tier, a, b, c, tier, $0
    }' | sort -t $'\t' -k1,1n -k2,2n -k3,3n -k4,4 | cut -f5-
}

is_token_dir() { [[ $1 != "${MAIN_DIR}" && -f $1/${TOKEN_FILE} ]]; }

# Rows for every login account (the slot included), probed in parallel. This
# is all the snapshot holds: token rows are rendered from their own readings
# whenever rows are read, so no snapshot can carry an older token observation
# than its reading.
gather_logins() {
  local tmp name dir i=0
  tmp=$(mktemp -d)
  while IFS=$'\t' read -r name dir; do
    [[ -z ${name} ]] || is_token_dir "${dir}" && continue
    # A neutral cwd: from inside a repo, every probe would load that repo's
    # project settings under each roster login.
    (cd "${CACHE_DIR}" && probe "${name}" "${dir}") > "${tmp}/$(printf '%03d' "${i}")" &
    i=$((i + 1))
  done < <(account_rows)
  wait
  ((i)) && cat "${tmp}"/*
  rm -rf "${tmp}"
  return 0
}

# Rows for every token account; $1=live may probe a stale reading.
token_rows() {
  local mode="$1" tmp name dir i=0
  tmp=$(mktemp -d)
  while IFS=$'\t' read -r name dir; do
    if [[ -z ${name} ]] || ! is_token_dir "${dir}"; then continue; fi
    token_row "${name}" "$(basename "${dir}")" "${mode}" > "${tmp}/$(printf '%03d' "${i}")" &
    i=$((i + 1))
  done < <(account_rows)
  wait
  ((i)) && cat "${tmp}"/*
  rm -rf "${tmp}"
  return 0
}

finalize() { mark_active | rank_rows | cut -f2-; }

# Every account, probed now (tokens per TOKEN_MODE), finalized.
gather() {
  local rows lt tt
  mkdir -p "${CACHE_DIR}"
  lt=$(mktemp); tt=$(mktemp)
  gather_logins > "${lt}" &
  token_rows "${TOKEN_MODE}" > "${tt}" &
  wait
  rows=$(cat "${lt}" "${tt}")
  rm -f "${lt}" "${tt}"
  [[ -n ${rows//$'\n'/} ]] || die "no accounts found. Add one: claude-usage add <name>"
  finalize <<< "${rows}"
}

# Pad a cell to a visible width: printf's %-Ns counts ANSI escapes as
# characters, so colour + %-Ns silently shreds the column alignment.
pad_cell() {
  local painted="$1" plain="$2" width="$3" align="$4" pad
  pad=$((width - ${#plain}))
  ((pad < 0)) && pad=0
  if [[ ${align} == right ]]; then
    printf '%*s%s' "${pad}" "" "${painted}"
  else
    printf '%s%*s' "${painted}" "${pad}" ""
  fi
}

# Horizontal border: corner chars, then one width per column.
hrule() {
  local l="$1" m="$2" r="$3"; shift 3
  local out="${l}" w first=1 i
  for w in "$@"; do
    ((first)) || out+="${m}"
    first=0
    for ((i = 0; i < w + 2; i++)); do out+="─"; done
  done
  printf '%s%s\n' "${out}" "${r}"
}

pct_plain() {
  if [[ $1 == "-" ]]; then printf -- '-'; else printf '%s%%' "$1"; fi
}

pct_paint() {
  if [[ $1 == "-" ]]; then printf '%s-%s' "${DIM}" "${RST}"; else paint_left "$1"; fi
}

# A 5h reset as its table cell shows it: the time alone when it falls today, with the day otherwise;
# "reset" once it has passed (the reading predates it, so its percentage is stale); nothing when it is
# unreadable or beyond one window ahead, which also rejects to_epoch's year rollover of an old reading.
# The CLI may print a reset as a bare time ("1am"); one already behind us is tomorrow's if that falls
# within the window, else an elapsed one. Assumes the CLI prints this machine's timezone, as WEEK does.
session_when() {
  local when="$1" e t now
  [[ -z ${when} || ${when} == "-" ]] && return 0
  now=$(date +%s)
  if [[ ${when} =~ ^[0-9] ]]; then
    e=$(to_epoch "$(date '+%b %-d') ${when}")
    [[ ${e} == "${NEVER}" ]] && return 0
    e=$((10#${e}))
    if ((e <= now)); then
      # Tomorrow's date from today's noon: noon plus a day stays on the next date across a DST change.
      t=$(to_epoch "$(fmt_epoch "$((10#$(to_epoch "$(date '+%b %-d') 12pm") + 86400))" '%b %-d') ${when}")
      [[ ${t} != "${NEVER}" ]] && ((10#${t} <= now + SESSION_WINDOW)) && e=$((10#${t}))
    fi
  else
    e=$(to_epoch "${when}")
    [[ ${e} == "${NEVER}" ]] && return 0
    e=$((10#${e}))
  fi
  ((e <= now)) && { printf 'reset'; return 0; }
  ((e > now + SESSION_WINDOW)) && return 0
  if [[ $(fmt_epoch "${e}" '%F') == "$(date '+%F')" ]]; then
    fmt_epoch "${e}" '%-I:%M%p' | sed -E -e 's/AM$/am/' -e 's/PM$/pm/' -e 's/:00(am|pm)$/\1/'
  else
    fmt_epoch "${e}" '%b %-d %-I:%M%p' | sed -E -e 's/AM$/am/' -e 's/PM$/pm/' -e 's/:00(am|pm)$/\1/'
  fi
}

table() {
  local rows key name email plan sl sr wl wr pl pv active org obs note swhen spct
  rows=$(gather) || exit 1

  local -a n_c=() p_c=() s_pl=() s_pa=() w_pl=() w_pa=() x_pl=() x_pa=() notes=()
  local plabel="PREMIUM" when days why tokens=0 dead_alias
  # The roster row the slot would have been, had its credential worked.
  dead_alias=$(awk -F'\t' '
    $2 == "main" { me = $3; mo = $12; personal = ($4 == "max" || $4 == "pro") }
    $2 != "main" && $14 != "" { n[++k] = $2; e[k] = $3; o[k] = $12 }
    END { for (i = 1; i <= k; i++) if ((me != "" && me != "-" && e[i] == me) || (personal && mo != "-" && o[i] == mo)) { print n[i]; exit } }' <<< "${rows}")
  local h0="ACCOUNT" h1="PLAN" h2="SESSION" h3="WEEK (all)"
  local w0=${#h0} w1=${#h1} w2=${#h2} w3=${#h3} w4

  while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
    [[ -z ${name} ]] && continue
    [[ -n ${note} ]] && notes+=("${name}: ${note}")
    if [[ ${pl} != "-" && -n ${pl} ]]; then
      local up; up=$(tr '[:lower:]' '[:upper:]' <<< "${pl}")
      # Accounts metering different premium models cannot share a column name.
      if [[ ${plabel} == PREMIUM || ${plabel} == "${up}" ]]; then plabel="${up}"; else plabel="PREMIUM"; fi
    fi

    when=${wr/ at / }
    if [[ ${active} == 1 ]]; then
      n_c+=("▶ ${name}")
      if [[ ${name} == main ]]; then
        if [[ -n ${dead_alias} ]]; then
          notes+=("main: same account as ${dead_alias}, whose credential is unusable — main is used instead")
        else
          notes+=("main: this login is not in the roster yet — claude-usage add <name> gives it a name")
        fi
      fi
    else
      n_c+=("  ${name}")
    fi
    if [[ ${plan} == token ]]; then
      tokens=1
      if [[ ${wl} == "-" && -z ${note} ]]; then
        why=$(token_read "$(key_for "${name}")" | cut -f15)
        [[ ${why} == "-" ]] && why=""
        notes+=("${name}: usage unknown — ${why:-not probed yet}")
      elif [[ ${obs} =~ ^[0-9]+$ ]] && (($(date +%s) - obs > TTL)); then
        notes+=("${name}: reading is $((($(date +%s) - obs) / 60))m old")
      fi
      days=$(token_days_left "$(key_for "${name}")")
      if [[ ${days} == -* ]]; then
        plan="token EXPIRED"
      elif [[ ${days} =~ ^[0-9]+$ ]]; then
        plan="token ${days}d"
        ((days <= TOKEN_WARN_DAYS)) && notes+=("⚠ ${name} token ${days}d left — mint a new one (claude setup-token), then: claude-usage add ${name}")
      fi
    fi
    p_c+=("${plan}")
    swhen=$(session_when "${sr}")
    spct=$(pct_plain "${sl}")
    if [[ -z ${swhen} ]]; then
      s_pl+=("$(printf '%4s' "${spct}")")
      s_pa+=("$(printf '%*s%s' "$((4 - ${#spct}))" "" "$(pct_paint "${sl}")")")
    else
      s_pl+=("$(printf '%4s  %s' "${spct}" "${swhen}")")
      s_pa+=("$(printf '%*s%s  %s%s%s' "$((4 - ${#spct}))" "" "$(pct_paint "${sl}")" "${DIM}" "${swhen}" "${RST}")")
    fi
    x_pl+=("$(pct_plain "${pv}")");  x_pa+=("$(pct_paint "${pv}")")
    if [[ ${wl} == "-" || ${when} == "-" ]]; then
      w_pl+=("$(pct_plain "${wl}")"); w_pa+=("$(pct_paint "${wl}")")
    else
      w_pl+=("$(printf '%4s  %s' "$(pct_plain "${wl}")" "${when}")")
      w_pa+=("$(printf '%*s%s  %s%s%s' "$((4 - ${#wl} - 1))" "" "$(pct_paint "${wl}")" "${DIM}" "${when}" "${RST}")")
    fi
  done <<< "${rows}"

  ((${#n_c[@]})) || die "no accounts to show"
  w4=${#plabel}

  local i
  for ((i = 0; i < ${#n_c[@]}; i++)); do
    ((${#n_c[i]} > w0)) && w0=${#n_c[i]}
    ((${#p_c[i]} > w1)) && w1=${#p_c[i]}
    ((${#s_pl[i]} > w2)) && w2=${#s_pl[i]}
    ((${#w_pl[i]} > w3)) && w3=${#w_pl[i]}
    ((${#x_pl[i]} > w4)) && w4=${#x_pl[i]}
  done

  hrule "┌" "┬" "┐" "${w0}" "${w1}" "${w2}" "${w3}" "${w4}"
  printf '│ %s%-*s%s │ %s%-*s%s │ %s%-*s%s │ %s%-*s%s │ %s%*s%s │\n' \
    "${BOLD}" "${w0}" "${h0}" "${RST}" "${BOLD}" "${w1}" "${h1}" "${RST}" \
    "${BOLD}" "${w2}" "${h2}" "${RST}" "${BOLD}" "${w3}" "${h3}" "${RST}" \
    "${BOLD}" "${w4}" "${plabel}" "${RST}"
  hrule "├" "┼" "┤" "${w0}" "${w1}" "${w2}" "${w3}" "${w4}"

  for ((i = 0; i < ${#n_c[@]}; i++)); do
    printf '│ '
    pad_cell "${n_c[i]}" "${n_c[i]}" "${w0}" left;               printf ' │ '
    pad_cell "${p_c[i]}" "${p_c[i]}" "${w1}" left;               printf ' │ '
    pad_cell "${s_pa[i]}" "${s_pl[i]}" "${w2}" left;             printf ' │ '
    pad_cell "${w_pa[i]}" "${w_pl[i]}" "${w3}" left;             printf ' │ '
    pad_cell "${x_pa[i]}" "${x_pl[i]}" "${w4}" right;            printf ' │\n'
  done
  hrule "└" "┴" "┘" "${w0}" "${w1}" "${w2}" "${w3}" "${w4}"

  if [[ -n ${GRN} ]]; then
    printf '%s  ▶ = active in ~/.claude · all values = %% LEFT   %sgreen >50%s %s· %syellow ≤50%s %s· %sred ≤15%s\n' \
      "${DIM}" "${GRN}" "${RST}${DIM}" "${DIM}" "${YEL}" "${RST}${DIM}" "${DIM}" "${RED}" "${RST}"
  else
    printf '  ▶ = active in ~/.claude · all values = %% LEFT\n'
  fi
  ((tokens)) && notes+=("token rows: a setup-token cannot read /usage; numbers come from the rate-limit headers of a 1-token Fable request, at most once per ${TTL}s")
  local n
  ((${#notes[@]})) || return 0
  for n in "${notes[@]}"; do
    printf '%s  %s%s\n' "${DIM}" "${n}" "${RST}"
  done
  return 0
}

jq_str() {
  printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

json() {
  local rows first=1 key name email plan sl sr wl wr pl pv active org obs note days
  rows=$(gather) || exit 1
  printf '['
  while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
    [[ -z ${name} ]] && continue
    ((first)) || printf ','
    first=0
    days=null
    if [[ ${plan} == token ]]; then
      days=$(token_days_left "$(key_for "${name}")")
      [[ ${days} =~ ^-?[0-9]+$ ]] || days=null
    fi
    printf '\n  {"account":"%s","active":%s,"email":"%s","plan":"%s","session_left_pct":%s,"session_resets":"%s","week_left_pct":%s,"week_resets":"%s","premium_model":"%s","premium_left_pct":%s,"token_days_left":%s,"observed_at":%s,"note":"%s"}' \
      "$(jq_str "${name}")" "$([[ ${active} == 1 ]] && printf true || printf false)" "$(jq_str "${email}")" "$(jq_str "${plan}")" \
      "${sl//-/null}" "$(jq_str "${sr}")" "${wl//-/null}" "$(jq_str "${wr}")" \
      "$(jq_str "${pl}")" "${pv//-/null}" "${days}" "$([[ ${obs} =~ ^[1-9][0-9]*$ ]] && printf '%s' "${obs}" || printf null)" "$(jq_str "${note}")"
  done <<< "${rows}"
  printf '\n]\n'
  return 0
}

# Seconds since a file or dir was written, or NEVER when there is none.
file_age() {
  local mt now
  [[ -e $1 ]] || { printf '%s' "${NEVER}"; return; }
  # `stat -f` means "format" to BSD stat and "filesystem" to GNU stat, so the
  # wrong one returns junk instead of failing. Validate rather than trust.
  mt=$(stat -c %Y "$1" 2> /dev/null)
  [[ ${mt} =~ ^[0-9]+$ ]] || mt=$(stat -f %m "$1" 2> /dev/null)
  [[ ${mt} =~ ^[0-9]+$ ]] || { printf '%s' "${NEVER}"; return; }
  now=$(date +%s)
  printf '%s' "$((now - mt))"
}

snapshot_age() { file_age "${SNAPSHOT}"; }

# Drop the lock only while we still hold it: one stolen after a stall belongs
# to another process now.
release_lock() {
  [[ $(cat "${LOCK_DIR}/pid" 2> /dev/null) == "$$" ]] && rm -rf "${LOCK_DIR}"
  return 0
}

# Probe every account and write the snapshot. mkdir is atomic, so of the N
# agents that may fire this at once exactly one proceeds; the rest return
# immediately rather than stampeding the CLI with duplicate probes.
cmd_refresh() {
  mkdir -p "${CACHE_DIR}"
  if ! mkdir "${LOCK_DIR}" 2> /dev/null; then
    local holder aged capped
    holder=$(cat "${LOCK_DIR}/pid" 2> /dev/null)
    [[ -n $(find "${LOCK_DIR}" -maxdepth 0 -mmin +5 2> /dev/null) ]] && aged=1 || aged=""
    # A recycled pid could otherwise keep a dead lock alive forever, so age
    # eventually wins regardless of liveness.
    [[ -n $(find "${LOCK_DIR}" -maxdepth 0 -mmin +30 2> /dev/null) ]] && capped=1 || capped=""
    if [[ -z ${capped} ]]; then
      [[ ${holder} =~ ^[0-9]+$ ]] && kill -0 "${holder}" 2> /dev/null && return 0
      [[ -n ${aged} ]] || return 0
    fi
    # Claim the stale lock by renaming it: mv is atomic, so of N racers exactly
    # one succeeds and the losers back off instead of all recreating it.
    local grave="${LOCK_DIR}.dead.$$"
    mv "${LOCK_DIR}" "${grave}" 2> /dev/null || return 0
    rm -rf "${grave}"
    mkdir "${LOCK_DIR}" 2> /dev/null || return 0
  fi
  printf '%s' "$$" > "${LOCK_DIR}/pid"
  trap 'release_lock' EXIT
  # Another racer may have stolen and recreated the lock between our checks and
  # our claim; whoever wrote the pid last owns it.
  [[ $(cat "${LOCK_DIR}/pid" 2> /dev/null) == "$$" ]] || return 0
  rm -rf "${LOCK_DIR:?}".dead.* 2> /dev/null   # graves from refreshers that died mid-steal

  local tmp="${SNAPSHOT}.$$"
  [[ ${TOKEN_MODE} == live ]] && token_rows live > /dev/null 2>&1 &
  gather_logins > "${tmp}" 2> /dev/null &
  wait
  mv -f "${tmp}" "${SNAPSHOT}"   # atomic swap: readers never see a half-written file
  return 0
}

# Passive: the status line and other background triggers never spend
# inference, so token rows keep their cached readings.
spawn_refresh() {
  ( _CLAUDE_USAGE_PASSIVE=1 "$0" refresh > /dev/null 2>&1 & ) 2> /dev/null
}

# Rows from cache, refreshing in the background when stale. Returns non-zero
# only when there is nothing cached at all — the first run after install.
cached_rows() {
  (($(snapshot_age) > TTL)) && spawn_refresh
  snapshot_rows
}

# Finalized rows from the snapshot plus every token's latest reading. Never
# probes or spawns anything.
snapshot_rows() {
  [[ -f ${SNAPSHOT} ]] || return 1
  { cat "${SNAPSHOT}"; token_rows cached; } | finalize
}

# Which account this shell is pointed at. Claude Code's status-line payload
# carries no account identity, so the config dir is the only signal. An unset
# variable means the slot, whose name is whatever the snapshot matched it to.
# $1: finalized rows already read, else the snapshot's.
current_account() {
  local d="${CLAUDE_CONFIG_DIR:-}" rows="${1:-}" key name email plan sl sr wl wr pl pv active org obs note
  if [[ -z ${d} ]]; then
    [[ -n ${rows} ]] || rows=$(snapshot_rows 2> /dev/null)
    while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
      [[ ${active} == 1 ]] && { printf '%s' "${name}"; return; }
    done <<< "${rows}"
    printf 'main'; return
  fi
  d=$(cd "${d}" 2> /dev/null && pwd -P) || { printf '%s' "${UNKNOWN}"; return; }
  # Immediate child only: $ACCOUNTS_ROOT/b/a is not the account "a".
  if [[ -n ${ACCOUNTS_ROOT} && $(dirname "${d}") == "${ACCOUNTS_ROOT}" ]]; then
    label_for "$(basename "${d}")"
  else
    # Includes CLAUDE_CONFIG_DIR=~/.claude, which is NOT the primary account:
    # setting the variable at all selects a different keychain entry.
    printf '%s' "${UNKNOWN}"
  fi
}

spent() { [[ $1 =~ ^[0-9]+$ ]] && (($1 == 0)); }

# The pick for TARGET_MODEL, as "name \t p_left \t p_label \t w_reset \t how":
# how is ok (measured headroom), unknown (nothing measured has any; this one
# has missing measurements and no known spent bucket; p_label is "token" for
# a token account) or fallback (everything is spent; this one frees up first).
best_row() {
  local tier key name email plan sl sr wl wr pl pv active org obs note rows
  rows=$(cat)
  while IFS=$'\t' read -r tier key name email plan sl sr wl wr pl pv active org obs note; do
    [[ -z ${name} ]] && continue
    # Expiry is re-checked live: the snapshot can predate it.
    [[ ${plan} == token && $(token_days_left "$(key_for "${name}")") == -* ]] && continue
    case ${tier} in
      0) printf '%s\t%s\t%s\t%s\tok\n' "${name}" "${pv}" "${pl}" "${wr}"; return 0 ;;
      1) [[ ${plan} == token ]] && pl=token
         printf '%s\t%s\t%s\t%s\tunknown\n' "${name}" "${pv}" "${pl}" "${wr}"; return 0 ;;
      2) printf '%s\t%s\t%s\t%s\tfallback\n' "${name}" "${pv}" "${pl}" "${wr}"; return 0 ;;
    esac
  done < <(rank_rows <<< "${rows}")
  return 1
}

cmd_best() {
  local name pv pl wr how rows
  ensure_snapshot live
  rows=$(cached_rows) || die "no snapshot yet — run: claude-usage refresh"
  IFS=$'\t' read -r name pv pl wr how < <(best_row <<< "${rows}") ||
    die "no usable account (all logged out?) — run: claude-usage"
  if [[ ${how} == fallback && ${pv} == 0 ]]; then
    printf '%s (no %s left on any usable account; frees up first, resets %s)\n' "${name}" "${pl}" "${wr}"
  elif [[ ${how} == fallback ]]; then
    printf '%s (nothing usable right now; frees up first, %s)\n' "${name}" "${wr}"
  elif [[ ${how} == unknown && ${pl} == token ]]; then
    printf '%s (token account, usage unknown; nothing measured has headroom)\n' "${name}"
  elif [[ ${how} == unknown ]]; then
    printf '%s (usage unknown; nothing measured has headroom)\n' "${name}"
  elif [[ ${wr} == idle ]]; then
    printf '%s (idle: no window open, everything left)\n' "${name}"
  elif [[ ${pv} == "-" ]]; then
    printf '%s (headroom left; week resets %s)\n' "${name}" "${wr}"
  else
    printf '%s (%s%% %s left)\n' "${name}" "${pv}" "${pl}"
  fi
}

# "Sep 28, 7:59am" or "Sep 28 at 7:59am" → "Sep 28".
reset_day() { local d=${1/ at */}; printf '%s' "${d%%,*}"; }

# " ⚠ <name> token <N>d left" for every token in its last month, live from
# the add dates: an expiry must surface even when no refresh is running.
token_warnings() {
  local dir key days
  for dir in "${ACCOUNTS_ROOT}"/*/; do
    [[ -f ${dir}${TOKEN_FILE} ]] || continue
    key=$(basename "${dir}")
    valid_name "${key}" || continue
    days=$(token_days_left "${key}")
    if [[ ${days} == -* ]]; then
      printf ' %s⚠ %s token expired%s' "${RED}" "$(label_for "${key}")" "${RST}"
    elif [[ ${days} =~ ^[0-9]+$ ]] && ((days <= TOKEN_WARN_DAYS)); then
      printf ' %s⚠ %s token %sd left%s' "${YEL}" "$(label_for "${key}")" "${days}" "${RST}"
    fi
  done
}

# One compact status-line segment. Reads cache only — never probes inline.
# Deliberately omits 5h/week percentages: the status line already gets those
# live for the current account, and the snapshot's copy would only be staler.
cmd_statusline() {
  local rows cur best_name best_pv best_wr best_how cur_pv cur_pl found=0 age oldest
  local key name email plan sl sr wl wr pl pv active org obs note out now

  rows=$(cached_rows) || return 0
  cur=$(current_account "${rows}")

  # Both halves of the segment come from ONE snapshot read: two reads could
  # straddle a refresh and render a current/best pair that never coexisted.
  if ! IFS=$'\t' read -r best_name best_pv _ best_wr best_how < <(best_row <<< "${rows}"); then
    out=$(token_warnings)
    [[ -n ${out} ]] && printf '%s\n' "${out# }"
    return 0
  fi

  # Token readings are not refreshed by the status line's own trigger, so the
  # age that matters is the oldest reading shown, not the snapshot's.
  oldest=$(date +%s)
  while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
    [[ ${name} == "${cur}" || ${name} == "${best_name}" ]] || continue
    [[ ${obs} =~ ^[0-9]+$ ]] && ((obs < oldest)) && oldest=${obs}
    [[ ${name} == "${cur}" ]] || continue
    cur_pv="${pv}"; cur_pl="${pl}"; [[ ${wr} == idle ]] && cur_pl=idle; found=1
  done <<< "${rows}"

  # The sentinel is unspellable as an account name on purpose; spell it out
  # for the human reading the bar.
  if [[ ${cur} == "${UNKNOWN}" ]]; then out="${DIM}unknown acct${RST}"; else out="${cur}"; fi
  if ((found)) && [[ ${cur_pv} != "-" ]]; then
    out="${out} ${DIM}$(tr '[:upper:]' '[:lower:]' <<< "${cur_pl}")${RST} $(paint_left "${cur_pv}")"
  fi
  if [[ ${best_name} != "${cur}" ]]; then
    out="${out} ${YEL}→${RST} ${best_name}"
    if [[ ${best_how} == unknown ]]; then
      out="${out} ${DIM}usage ?${RST}"
    elif [[ ${best_how} == fallback ]]; then
      # A fallback pick is not usable yet; quoting its premium headroom would
      # read as "switch here now".
      out="${out} ${DIM}back $(reset_day "${best_wr}")${RST}"
    elif [[ ${best_pv} != "-" ]] && ((best_pv > 0)); then
      out="${out} $(paint_left "${best_pv}")"
    else
      out="${out} ${DIM}$(reset_day "${best_wr}")${RST}"
    fi
  elif [[ ${best_how} == fallback ]]; then
    out="${out} ${DIM}all spent, back $(reset_day "${best_wr}")${RST}"
  else
    out="${out} ${GRN}✓${RST}"
  fi
  # A snapshot this old means background refreshes are failing, not that usage
  # has been flat for an hour.
  age=$(snapshot_age); now=$(date +%s)
  ((age > TTL * 6 || now - oldest > TTL * 6)) && out="${out} ${DIM}(stale)${RST}"
  out="${out}$(token_warnings)"

  printf '%s\n' "${out}"
}

scrub_auth_env() {
  local v
  for v in "${AUTH_ENV[@]}"; do unset "${v}"; done
}

# Reads a setup-token from the terminal (hidden) or from stdin, and extracts it
# from whatever surrounds it, so the whole `claude setup-token` output can be
# pasted or piped. Builtins only: a here-string or a command argument would put
# the token in a temp file or in ps.
read_token() {
  local raw=""
  xtrace_off
  if [[ -t 0 ]]; then
    # shellcheck disable=SC2016 # literal backticks: a command to copy
    printf 'Run `claude setup-token` on any machine, then paste it.\n' >&2
    printf 'token for %s (hidden): ' "$1" >&2
    IFS= read -rs raw
    printf '\n' >&2
  else
    IFS= read -r -d '' raw
  fi
  if [[ ${raw} =~ (sk-ant-oat[0-9]+-[A-Za-z0-9_-]+) && ${#BASH_REMATCH[1]} -ge 60 ]]; then
    TOKEN="${BASH_REMATCH[1]}"
    raw=""; [[ ${raw} =~ ^$ ]]   # drop the match: BASH_REMATCH outlives this function
    xtrace_restore
    return 0
  fi
  [[ ${raw} == *sk-ant-api* ]] && die "that is an API key, not a setup-token — nothing saved"
  die "no setup-token found in the input (expected sk-ant-oat…) — nothing saved"
}

cmd_add() {
  local name="" extra="" mode=token arg
  for arg in "$@"; do
    # Checked before anything else, so no path can store or echo it.
    if [[ ${arg} == *sk-ant-* ]]; then
      die "refusing a token on the command line: it is now in your shell history and visible to ps — mint a new one, then pipe or paste it: claude-usage add <name>"
    fi
  done
  for arg in "$@"; do
    case ${arg} in
      --login) mode=login ;;
      --token) mode=token ;;
      -*)      die "unknown option: ${arg}" ;;
      *)       if [[ -z ${name} ]]; then name="${arg}"; elif [[ -z ${extra} ]]; then extra="${arg}"; else die "usage: claude-usage add <name> [--login [email]]"; fi ;;
    esac
  done
  [[ -n ${name} ]] || die "usage: claude-usage add <name> [--login [email]]"
  [[ -n ${extra} && ${mode} == token ]] && die "an email only goes with --login: claude-usage add ${name} --login ${extra}"
  [[ ${name} == main ]] && die "'main' is reserved for ~/.claude"
  [[ ${name} == best || ${name} == other ]] && die "'${name}' is reserved: it means \"pick for me\" in run and resolve"
  valid_name "${name}" || die "invalid name: ${name} (letters, digits, . _ - only)"
  # An existing label adds in place: a second directory under the same display
  # name would make every lookup ambiguous.
  local key dir
  key=$(key_for "${name}")
  dir="${ACCOUNTS_ROOT}/${key}"
  [[ -e ${dir} && ! -d ${dir} ]] && die "${dir} exists and is not a directory"
  [[ -L ${dir} ]] && die "${dir} is a symlink — refusing to write credentials through it"

  if [[ ${mode} == token ]]; then
    local TOKEN="" tmp
    read_token "${name}"   # before mkdir: a rejected token leaves no empty account behind
    (umask 077 && mkdir -p "${dir}") || die "cannot create ${dir}"
    tmp=$(umask 077 && mktemp "${dir}/.${TOKEN_FILE}.XXXXXX") || die "cannot write in ${dir}"
    xtrace_off
    if ! { printf '%s\n' "${TOKEN}" > "${tmp}" && chmod 600 "${tmp}" && mv -f "${tmp}" "${dir}/${TOKEN_FILE}"; }; then
      rm -f "${tmp}"
      die "could not save the token — nothing saved"
    fi
    TOKEN=""
    xtrace_restore
    date +%s > "${dir}/${TOKEN_DATE}"
    rm -f "${SNAPSHOT}" "$(token_cache "${key}")" "$(token_org_file "${key}")"
    printf '✓ %s saved (token, expires ~%s)\n' "${name}" "$(token_expiry "${key}" '%Y-%m')"
    return 0
  fi

  mkdir -p "${dir}"
  printf 'Logging in to account %s (config dir: %s)\n' "${name}" "${dir}"
  if ! (
    scrub_auth_env
    if [[ -n ${extra} ]]; then
      CLAUDE_CONFIG_DIR="${dir}" claude auth login --claudeai --email "${extra}"
    else
      CLAUDE_CONFIG_DIR="${dir}" claude auth login --claudeai
    fi
  ); then
    die "login failed — ${name} unchanged"
  fi
  # The token would outrank the login just made.
  rm -f "${dir}/${TOKEN_FILE}" "${dir}/${TOKEN_DATE}" "$(token_cache "${key}")" "$(token_org_file "${key}")"
  rm -f "${SNAPSHOT}"   # the roster changed; the next render re-matches the slot
  local added main_email
  added=$(run_claude "${dir}" auth status --json 2> /dev/null | sed -n 's/.*"email": "\([^"]*\)".*/\1/p' | head -1)
  main_email=$(run_claude "${MAIN_DIR}" auth status --json 2> /dev/null | sed -n 's/.*"email": "\([^"]*\)".*/\1/p' | head -1)
  if [[ -n ${added} && ${added} == "${main_email}" ]]; then
    printf 'This is also the account logged into ~/.claude — it now shows as "%s" (active).\n' "${name}"
  fi
}
# Remove one mapping by exact key match, never by pattern.
drop_label() {
  local key="$1" line tmp
  [[ -f ${LABELS_FILE} ]] || return 0
  tmp="${LABELS_FILE}.$$"
  : > "${tmp}"
  while IFS= read -r line || [[ -n ${line} ]]; do
    [[ ${line} == "${key}="* ]] && continue
    printf '%s\n' "${line}" >> "${tmp}"
  done < "${LABELS_FILE}"
  mv -f "${tmp}" "${LABELS_FILE}"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}" key line
  [[ -n ${old} && -n ${new} ]] || die "usage: claude-usage rename <current-name> <new-name>"
  valid_name "${new}" || die "invalid name: ${new} (letters, digits, . _ - only; no leading dot)"

  key=$(key_for "${old}")
  [[ ${key} == main ]] && die "main is the ~/.claude slot, not an account: it takes the name of the roster account logged into it (claude-usage add <name>)"
  [[ -d ${ACCOUNTS_ROOT}/${key} ]] || die "unknown account: ${old} (try: claude-usage list)"
  [[ ${new} == main ]] && die "'main' is reserved for ~/.claude"
  [[ ${new} == best || ${new} == other ]] && die "'${new}' is reserved: it means \"pick for me\" in run and resolve"
  local taken; taken=$(key_for "${new}")
  [[ ${taken} != "${key}" && -d ${ACCOUNTS_ROOT}/${taken} ]] &&
    die "name already in use: ${new}"

  mkdir -p "${ACCOUNTS_ROOT}"
  local tmp="${LABELS_FILE}.$$" line
  : > "${tmp}"
  if [[ -f ${LABELS_FILE} ]]; then
    while IFS= read -r line || [[ -n ${line} ]]; do
      [[ ${line} == "${key}="* ]] && continue
      printf '%s\n' "${line}" >> "${tmp}"
    done < "${LABELS_FILE}"
  fi
  [[ ${new} != "${key}" ]] && printf '%s=%s\n' "${key}" "${new}" >> "${tmp}"
  mv -f "${tmp}" "${LABELS_FILE}"

  rm -f "${SNAPSHOT}"   # the cached rows carry the old name
  printf '%s → %s\n' "${old}" "${new}"
}

cmd_remove() {
  local name="${1:-}" dir key
  [[ -n ${name} ]] || die "usage: claude-usage remove <name>"
  key=$(key_for "${name}")
  dir=$(resolve_dir "${name}") || exit 1
  # Guard the RESOLVED target, never the argument: the primary account can
  # carry any label, and "../.claude" resolves there too.
  [[ ${key} == main || ${dir} == "${MAIN_DIR}" ]] &&
    die "refusing to remove the primary account (${MAIN_DIR}) — use: claude auth logout"
  [[ ${dir} == "${ACCOUNTS_ROOT}"/* ]] ||
    die "refusing: ${dir} is outside ${ACCOUNTS_ROOT}"
  local until=""
  if is_token "${key}"; then
    until=$(token_expiry "${key}" '%Y-%m-%d')
  else
    run_claude "${dir}" auth logout > /dev/null 2>&1
  fi
  rm -rf "${dir}"
  drop_label "${key}"
  rm -f "${SNAPSHOT}" "$(token_cache "${key}")" "$(token_org_file "${key}")"
  if [[ -n ${until} ]]; then
    printf 'removed %s (token file deleted; the token itself stays valid until ~%s)\n' "${name}" "${until}"
  else
    printf 'removed %s\n' "${name}"
  fi
}

cmd_list() {
  local name dir cur=""
  # No snapshot means nothing has been matched yet — claim nothing.
  [[ -f ${SNAPSHOT} ]] && cur=$(current_account)
  local key days tag
  while IFS=$'\t' read -r name dir; do
    [[ -z ${name} ]] && continue
    tag=""
    [[ ${name} == "${cur}" ]] && tag="  (active in ~/.claude)"
    key=$(basename "${dir}")
    if [[ ${dir} != "${MAIN_DIR}" ]] && is_token "${key}"; then
      days=$(token_days_left "${key}")
      if [[ ${days} == -* ]]; then tag="${tag}  (token, EXPIRED)"; else tag="${tag}  (token, ${days}d left)"; fi
    fi
    printf '%-14s %s%s\n' "${name}" "${dir}" "${tag}"
  done < <(account_rows)
}

cmd_show() {
  local name="${1:-}"
  [[ -n ${name} ]] || die "usage: claude-usage show <name>"
  local dir; dir=$(resolve_dir "${name}") || exit 1
  if [[ ${dir} != "${MAIN_DIR}" ]] && is_token "$(basename "${dir}")"; then
    local k obs result org sl sr ss wl wr ws pv pr ps why
    k=$(basename "${dir}")
    printf '%s: token account, expires ~%s.\n' "${name}" "$(token_expiry "${k}" '%Y-%m-%d')"
    [[ $(token_days_left "${k}") == -* ]] && return 0
    IFS=$'\t' read -r _ _ obs result org sl sr ss wl wr ws pv pr ps why < <(token_probe "${k}")
    if [[ ${result} != ok && ${result} != rejected ]]; then
      printf 'usage unknown: %s\n' "${why}"; return 0
    fi
    # Measurements as reported; the verdict uses the same reading of refusals
    # as the ranking does.
    local ns nw np
    IFS=$'\t' read -r ns nw np < <(token_norm "${result}" "${sl}" "${ss}" "${wl}" "${ws}" "${pv}" "${ps}")
    [[ ${ns} == 0 || ${nw} == 0 || ${np} == 0 ]] && printf 'refused or spent: not usable until a bucket resets\n'
    printf 'Current session: %s · resets %s (%s)\n' "$(pct_used "${sl}")" "$(fmt_reset "${sr}")" "${ss}"
    printf 'Current week (all models): %s · resets %s (%s)\n' "$(pct_used "${wl}")" "$(fmt_reset "${wr}")" "${ws}"
    printf 'Current week (%s): %s · resets %s (%s)\n' "${PREMIUM_LABEL}" "$(pct_used "${pv}")" "$(fmt_reset "${pr}")" "${ps}"
    printf '(rate-limit headers of a 1-token request, %ss ago; organization %s)\n' "$(($(date +%s) - obs))" "$(token_org "${k}")"
    return 0
  fi
  usage_text "${dir}"
}

# Key of the account best_row picks. Exit 1: only the least-bad pick (nothing
# usable). Exit 2: nothing to pick.
# Any token reading older than TTL (an expired token never counts).
tokens_stale() {
  local dir key rec
  [[ ${CLAUDE_USAGE_TOKEN_PROBE:-1} == 0 ]] && return 1
  for dir in "${ACCOUNTS_ROOT}"/*/; do
    [[ -f ${dir}${TOKEN_FILE} && ! -L ${dir%/} ]] || continue
    key=$(basename "${dir}")
    valid_name "${key}" || continue
    [[ $(token_days_left "${key}") == -* ]] && continue
    rec=$(token_read "${key}") || return 0
    reading_fresh "${rec}" || return 0
  done
  return 1
}

# A snapshot to choose from. Plain: fill a missing one without spending
# inference. live (best, resolve, run): also re-probe while any token reading
# is stale, waiting out a concurrent refresher, at most twice.
ensure_snapshot() {
  local mode="${1:-}" waited tries=0
  while ((tries < 2)); do
    if [[ -f ${SNAPSHOT} ]]; then
      [[ ${mode} == live ]] && tokens_stale || return 0
    else
      printf 'claude-usage: no snapshot yet — probing every account once…\n' >&2
    fi
    # A child, not cmd_refresh: run execs claude next, which would keep this
    # pid — and with it the refresh lock — alive for the whole session.
    if [[ ${mode} == live ]]; then
      env -u _CLAUDE_USAGE_PASSIVE "$0" refresh
    else
      _CLAUDE_USAGE_PASSIVE=1 "$0" refresh
    fi
    # It returns at once when another refresher holds the lock; wait for that one.
    waited=0
    while [[ -d ${LOCK_DIR} ]] && ((waited < TIMEOUT + 15)); do
      sleep 1; waited=$((waited + 1))
    done
    tries=$((tries + 1))
  done
}

# $1, when given, is a display name to leave out (the caller's own account)
# with every verified alias of it: a row sharing its email, or its personal
# organization, is the same quota under another credential, whichever row the
# table displays.
best_key() {
  local exclude="${1:-}" rows name how porgs
  ensure_snapshot live
  rows=$(cached_rows) || return 2
  # An organization is one person only on a verified personal plan (a login
  # reporting max or pro); a team shares one across many people.
  porgs=$(awk -F'\t' '$4 == "max" || $4 == "pro" { printf " %s", $12 }' "${SNAPSHOT}" 2> /dev/null)
  [[ -n ${exclude} ]] && rows=$(awk -F'\t' -v x="${exclude}" -v po="${porgs} " '
    { line[NR] = $0; n[NR] = $2; e[NR] = $3; o[NR] = $12; if ($2 == x) { me = $3; mo = $12 } }
    END {
      personal = (mo != "" && mo != "-" && index(po, " " mo " ") > 0)
      for (i = 1; i <= NR; i++) {
        if (n[i] == x) continue
        if (me != "" && me != "-" && e[i] == me) continue
        if (personal && o[i] == mo) continue
        print line[i]
      }
    }' <<< "${rows}")
  IFS=$'\t' read -r name _ _ _ how < <(best_row <<< "${rows}") || return 2
  # Rows carry display names. Exactly one account must still answer to it:
  # none means a rename since the snapshot, two a rename racing an add.
  case $(account_rows | cut -f1 | grep -cxF -- "${name}") in
    1) ;;
    0) printf 'claude-usage: %s was renamed or removed since the last probe — run: claude-usage refresh\n' "${name}" >&2; return 2 ;;
    *) printf 'claude-usage: two accounts are named %s — rename one\n' "${name}" >&2; return 2 ;;
  esac
  if [[ ${name} == main ]]; then printf 'main'; else key_for "${name}"; fi
  [[ ${how} != fallback ]]
}

# The best account other than the caller's. Identity is read only once a
# snapshot exists (the slot's name comes from it), and anything short of a
# usable, known, distinct account is an error: falling back would land the work
# on the very account it was meant to spare.
other_key() {
  local me key rc=0
  if account_rows | cut -f1 | grep -qxF other; then
    die "an account is named 'other', which is now a selector — rename it: claude-usage rename other <new-name>"
  fi
  ensure_snapshot live
  me=$(current_account)
  [[ ${me} == "${UNKNOWN}" ]] && die "cannot tell which account this shell is on (CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-unset})"
  key=$(best_key "${me}") || rc=$?
  ((rc == 0)) || die "no account besides ${me} has headroom right now — run: claude-usage"
  printf '%s' "${key}"
}

literal_key() {
  local k="$1"
  if [[ ${k} == main ]] || { valid_name "${k}" && [[ -d ${ACCOUNTS_ROOT}/${k} ]]; }; then
    printf '%s' "${k}"
  else
    die "no account with key: ${k}"
  fi
}

cmd_resolve() {
  local q="${1:-}" rc=0
  [[ -n ${q} ]] || die "usage: claude-usage resolve <name|best|other>"
  if [[ ${q} == best ]]; then
    best_key || rc=$?
    ((rc == 2)) && die "no usable account — run: claude-usage"
  elif [[ ${q} == other ]]; then
    other_key || exit 1
  elif [[ ${q} == =* ]]; then
    literal_key "${q#=}" || exit 1
  else
    resolve_key "${q}" || exit 1
  fi
  printf '\n'
  return "${rc}"
}

# Links one item of the slot's stack into a roster home. The link targets the
# slot's path, not the repo, so it follows wherever install.sh points the slot.
# Anything else already there is moved aside, never overwritten.
link_one() {
  local src="$1" dst="$2"
  [[ -e ${src} ]] || return 0
  [[ -L ${dst} && ${dst} -ef ${src} ]] && return 0
  if [[ -e ${dst} || -L ${dst} ]]; then
    [[ -n ${LINK_BACKUP} ]] || LINK_BACKUP="$(dirname "${dst}")/.claude-usage-backup/$(date +%Y%m%d-%H%M%S)-$$"
    # A concurrent run may have moved it first; the ln below settles either way.
    mkdir -p "${LINK_BACKUP}" && mv "${dst}" "${LINK_BACKUP}/" 2> /dev/null &&
      printf 'claude-usage: moved %s aside to %s\n' "${dst}" "${LINK_BACKUP}" >&2
  fi
  # A directory recreated since the move (a session running in this home)
  # would make ln put the link INSIDE it.
  if [[ -d ${dst} && ! -L ${dst} ]]; then
    printf 'claude-usage: %s is in use; not linked this time\n' "${dst}" >&2
    return 0
  fi
  # -n: never descend into a link to a directory a concurrent run just made.
  ln -sn "${src}" "${dst}" 2> /dev/null || [[ ${dst} -ef ${src} ]] ||
    printf 'claude-usage: could not link %s\n' "${dst}" >&2
}

# A roster home starts bare. settings.json is shared, not copied: Claude Code
# writes through the link (verified), so /model or an "always allow" from any
# account lands in the one user settings file, as with two sessions on the
# slot. plugins/ is shared whole: its install paths are absolute into the
# slot, its cache sweep trusts one installed_plugins.json, and the claude.ai
# sync keeps one bucket per account there. It holds no credentials; plugin MCP
# logins live with each account's own credentials. .claude.json (the account
# identity) and credentials stay per home.
LINK_BACKUP=""
link_stack() {
  local dir="$1" f e name sk="$1/skills"
  for f in CLAUDE.md AGENTS.md statusline.sh settings.json plugins; do
    link_one "${MAIN_DIR}/${f}" "${dir}/${f}"
  done
  [[ -d ${MAIN_DIR}/skills && ! -L ${sk} ]] || return 0
  mkdir -p "${sk}"
  for e in "${MAIN_DIR}"/skills/*; do
    [[ -e ${e} ]] || continue
    name=${e##*/}
    # synced/ holds claude.ai skills of whichever account synced them.
    [[ ${name} == synced ]] && continue
    # Present means ours already, or the account's own: leave it.
    [[ -e ${sk}/${name} || -L ${sk}/${name} ]] && continue
    ln -sn "${e}" "${sk}/${name}" 2> /dev/null
  done
  for e in "${sk}"/*; do
    [[ -L ${e} && ! -e ${e} ]] || continue
    [[ $(readlink "${e}") == "${MAIN_DIR}/skills/"* ]] && rm -f "${e}"
  done
  return 0
}

# One line on what the snapshot knows about an account's headroom.
describe() {
  local want="$1" key name email plan sl sr wl wr pl pv active org obs note out="" rows
  rows=$(snapshot_rows) || { printf 'headroom unknown (no snapshot yet)'; return; }
  while IFS=$'\t' read -r key name email plan sl sr wl wr pl pv active org obs note; do
    [[ ${name} == "${want}" ]] || continue
    [[ -n ${note} ]] && { printf '%s' "${note}"; return; }
    [[ ${wr} == idle ]] && { printf 'idle, everything left'; return; }
    [[ ${sl} != "-" ]] && out="5h ${sl}%"
    [[ ${wl} != "-" ]] && out="${out:+${out} · }week ${wl}%"
    [[ ${pv} != "-" ]] && out="${out:+${out} · }$(lower "${pl}") ${pv}%"
    printf '%s' "${out:+${out} left}"
    return
  done <<< "${rows}"
  printf 'headroom unknown'
}

# Starts claude on one account. The choice holds for that process only: the
# config dir, and the token for a token account, are exported to the exec'd
# claude and to nothing else.
cmd_run() {
  local q=best key rc=0 dir label days tok="" what
  if [[ ${1:-} == -- ]]; then
    shift
  elif [[ -n ${1:-} && ${1} != -* ]]; then
    q="$1"; shift
  fi
  if [[ ${q} == best ]]; then
    key=$(best_key) || rc=$?
    ((rc == 2)) && die "no usable account — run: claude-usage"
  elif [[ ${q} == other ]]; then
    key=$(other_key) || exit 1
  elif [[ ${q} == =* ]]; then
    key=$(literal_key "${q#=}") || exit 1
  else
    key=$(resolve_key "${q}") || exit 1
  fi

  scrub_auth_env
  if [[ ${key} == main ]]; then
    # Unset, not pointed at ~/.claude: the slot's keychain entry is keyed to
    # the variable's absence.
    unset CLAUDE_CONFIG_DIR
    label=main
  else
    dir="${ACCOUNTS_ROOT}/${key}"
    label=$(label_for "${key}")
    # Linking into a home that is really the slot would move the slot's own
    # files aside and leave links pointing at themselves.
    [[ -L ${dir} || ${dir} -ef ${MAIN_DIR} ]] && die "${dir} is a symlink — refusing to link the stack into it"
    link_stack "${dir}"
    export CLAUDE_CONFIG_DIR="${dir}"
  fi

  # Before any token is exported: the refresher must not inherit it.
  [[ -f ${SNAPSHOT} ]] && spawn_refresh_if_stale
  if is_token "${key}"; then
    days=$(token_days_left "${key}")
    [[ ${days} == -* ]] && die "${label}: token expired — mint a new one (claude setup-token), then: claude-usage add ${label}"
    xtrace_off
    { IFS= read -r tok || [[ -n ${tok} ]]; } < "${dir}/${TOKEN_FILE}"
    [[ -n ${tok} ]] || die "${label}: token file is empty — run: claude-usage add ${label}"
    export CLAUDE_CODE_OAUTH_TOKEN="${tok}"
    tok=""
    xtrace_restore
    what=$(describe "${label}")
    [[ ${what} == "headroom unknown"* ]] && what="no usage data"
    what="token, ${days}d left, ${what}"
  else
    what=$(describe "${label}")
  fi
  ((rc == 1)) && what="${what}; nothing has headroom, this one frees up first"
  printf 'claude-usage: %s — %s\n' "${label}" "${what}" >&2
  exec claude "$@"
}

spawn_refresh_if_stale() { (($(snapshot_age) > TTL)) && spawn_refresh; return 0; }

case "${1:-table}" in
  table|'')   table ;;
  --json)     json ;;
  refresh)    cmd_refresh ;;
  best)       cmd_best ;;
  statusline) cmd_statusline ;;
  run)        shift; cmd_run "$@" ;;
  resolve)    shift; cmd_resolve "$@" ;;
  current)    ensure_snapshot; me=$(current_account); printf '%s\n' "${me}"; [[ ${me} != "${UNKNOWN}" ]] ;;
  add)        shift; cmd_add "$@" ;;
  remove|rm)  shift; cmd_remove "$@" ;;
  rename)     shift; cmd_rename "$@" ;;
  list|ls)    cmd_list ;;
  show)       shift; cmd_show "$@" ;;
  -h|--help)  sed -n '2,/^$/p' "$0" | sed 's/^#\{1,\} \{0,1\}//;s/^#$//' ;;
  *)          die "unknown command: $1 (try --help)" ;;
esac
