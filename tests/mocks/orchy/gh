#!/usr/bin/env bash
# gh mock for smoke-orchy: fixtures in $MOCK_DIR (pr-<n>.json, issue-<n>.json, checks[-<sha>].json, status[-<sha>].json, trunk.json, compare.json, open.json, issues.json, merged.json, diff-<n>.txt, files-<n>.txt); every call logged to $MOCK_DIR/gh.log
set -u; echo "$*" >> "$MOCK_DIR/gh.log"
jqexpr=""; args=("$@"); for ((i=0;i<${#args[@]};i++)); do [ "${args[i]}" = --jq ] && jqexpr=${args[i+1]}; done
case "$1 $2" in
"auth status") exit 0;;
"pr view") f="$MOCK_DIR/pr-$3.json"; [ -f "$f" ] || { echo "no such pr" >&2; exit 1; }; jq -r "$jqexpr" "$f";;
"pr merge") n=$3; f="$MOCK_DIR/pr-$n.json"; want=""; for ((i=0;i<${#args[@]};i++)); do [ "${args[i]}" = --match-head-commit ] && want=${args[i+1]}; done
  [ -n "$want" ] || { echo "MOCK: merge without --match-head-commit" >&2; exit 1; }
  [ "$want" = "$(jq -r .headRefOid "$f")" ] || { echo "head commit mismatch" >&2; exit 1; }
  tmp=$(mktemp); jq '.state="MERGED" | .mergeCommit={oid:"deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}' "$f" > "$tmp" && mv "$tmp" "$f"; echo "✓ Squashed and merged";;
"pr diff") [ "${MOCK_GH_FAIL:-}" = diff ] && { echo "HTTP 500" >&2; exit 1; }; if printf '%s\n' "$@" | grep -qx -- --name-only; then cat "$MOCK_DIR/files-$3.txt"; else cat "$MOCK_DIR/diff-$3.txt"; fi;;
"issue view") f="$MOCK_DIR/issue-$3.json"; [ -f "$f" ] || { echo "no such issue" >&2; exit 1; }; jq -r "$jqexpr" "$f";;
"pr list") if printf '%s\n' "$@" | grep -qx -- merged; then jq -r "$jqexpr" "$MOCK_DIR/merged.json"; elif [ -f "$MOCK_DIR/open.json" ]; then jq -r "$jqexpr" "$MOCK_DIR/open.json"; fi;;
"issue list") [ "${MOCK_GH_FAIL:-}" = search ] && printf '%s\n' "$@" | grep -qx -- --search && { echo "HTTP 502" >&2; exit 1; }
  [ -e "$MOCK_DIR/fail-issues" ] && { echo "HTTP 502" >&2; exit 1; }
  [ -f "$MOCK_DIR/issues.json" ] || exit 1; jq -r "$jqexpr" "$MOCK_DIR/issues.json";;
"issue create") sleep "${MOCK_GH_DELAY:-0}"; [ "${MOCK_GH_FAIL:-}" = create ] && { echo "HTTP 500" >&2; exit 1; }
  echo "$*" >> "$MOCK_DIR/created.log"; echo "https://github.com/example/app/issues/${MOCK_ISSUE_NUMBER:-77}";;
"api repos/"*) s=$(sed -E 's#.*/commits/([^/]+)/.*#\1#' <<<"$2")   # per-sha fixtures (checks-<sha>.json) fall back to the shared one
  case "$2" in
  *check-runs) f="$MOCK_DIR/checks-$s.json"; [ -f "$f" ] || f="$MOCK_DIR/checks.json"; jq -r "$jqexpr" "$f";;
  *status) f="$MOCK_DIR/status-$s.json"; [ -f "$f" ] || f="$MOCK_DIR/status.json"; jq -r "$jqexpr" "$f";;
  */compare/*) [ -f "$MOCK_DIR/compare.json" ] || exit 1; jq -r "$jqexpr" "$MOCK_DIR/compare.json";;
  */commits/*) [ -f "$MOCK_DIR/trunk.json" ] || exit 1; jq -r "$jqexpr" "$MOCK_DIR/trunk.json";;
  *) exit 1;; esac;;
*) echo "MOCK gh: unhandled $*" >&2; exit 1;;
esac
