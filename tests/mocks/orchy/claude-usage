#!/usr/bin/env bash
# claude-usage mock: `run` is a lead (argv logged to $MOCK_DIR/cu.log, banner on stderr like the real one, init event,
# a session-leader grandchild like a Bash-tool shell, alive for $MOCK_LEAD_SECS, then a result event); `list`, `current` and
# `--json --cached` read fixtures in ${MOCK_CU:-$MOCK_DIR/cu} (list.txt, current.txt, rows.json; no rows.json is no snapshot);
# anything else prints a headroom table
C=${MOCK_CU:-$MOCK_DIR/cu}
case "${1:-}" in
list) cat "$C/list.txt"; exit;;
current) c=$(cat "$C/current.txt" 2>/dev/null || echo main); echo "$c"; [ "$c" != "?" ]; exit;;
--json) [ "${2:-}" = --cached ] || { echo "MOCK claude-usage: a live --json probe" >&2; exit 1; }
  [ -f "$C/rows.json" ] || { echo "no snapshot yet: run claude-usage refresh" >&2; exit 1; }; cat "$C/rows.json"; exit;;
run) ;;
*) echo "account  5h  week"; exit 0;;
esac
printf '%q ' "$@" >> "$MOCK_DIR/cu.log"; echo >> "$MOCK_DIR/cu.log"
echo "claude-usage: $2 — 80% left" >&2
echo '{"type":"system","subtype":"init","session_id":"'"${MOCK_SESSION:-00000000-0000-4000-8000-000000000001}"'"}'
setsid sleep "${MOCK_LEAD_SECS:-20}" & echo $! > "$MOCK_DIR/gc.$$"
i=0; while [ $i -lt "${MOCK_LEAD_SECS:-20}" ]; do sleep 1; i=$((i+1)); done
echo '{"type":"result","subtype":"success","total_cost_usd":0.5,"num_turns":3,"duration_ms":1000,"usage":{"input_tokens":10,"output_tokens":20,"cache_read_input_tokens":30,"cache_creation_input_tokens":40},"modelUsage":{"claude-opus-5-5":{"inputTokens":10,"outputTokens":20,"cacheReadInputTokens":30,"cacheCreationInputTokens":40,"costUSD":0.5}}}'
